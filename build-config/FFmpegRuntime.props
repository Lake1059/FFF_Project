<Project>
  <PropertyGroup>
    <FFmpegRoot>$(MSBuildThisFileDirectory)..\third_party\ffmpeg</FFmpegRoot>
    <FFmpegRuntimeDirectory>$(FFmpegRoot)\bin\x64</FFmpegRuntimeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- These ABI versions must match the native link and delay-load declarations. -->
    <FFmpegComponent Include="avcodec-63;avformat-63;avutil-61;avfilter-12;swresample-7;swscale-10" />
    <DevelopmentRuntime Include="@(FFmpegComponent->'$(FFmpegRuntimeDirectory)\%(Identity).dll')" />
  </ItemGroup>
</Project>
