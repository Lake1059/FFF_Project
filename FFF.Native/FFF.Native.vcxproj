  <!-- ════════════════════════════════════════════════════════════════════════════════
       构建后自动把内核 DLL 同步到 3fp\build\。

       为什么必须自动化：`3fp\build\FFF.Native.dll` 是所有探针读取的副本，但它**不是**
       构建产物 —— 历史上靠人工拷贝。2026-10-07/08 这个人工步骤造成了两次真实事故：

         · W-1（交付级）：build\ 副本停留在**修复前**二进制，于是"修复后"的测量
           实际测到的是修复前的 10000，差一步就误判"修复无效"。
         · 同源错误：用陈旧副本的输出去论证缺陷（vivid_hlg.txt 的 hdrFormat=0 签名），
           而那不是内核的真实行为。

       根本问题是"同一个逻辑二进制存在两份物理副本，且同步靠人记"。这里把它变成
       构建的一部分：**MSBuild 走哪条路都会同步**，包括手动调用 MSBuild、
       以及 tools\build_kernel_manual.py（它是 MSBuild 的薄封装）。
       ════════════════════════════════════════════════════════════════════════════════ -->
  <Target Name="SyncKernelToBuildDir" AfterTargets="Build" Condition="'$(Platform)'=='x64'">
    <PropertyGroup>
      <_SyncTargetDir>$(ProjectDir)..\..\build</_SyncTargetDir>
      <_SyncTargetDll>$(_SyncTargetDir)\FFF.Native.dll</_SyncTargetDll>
    </PropertyGroup>
    <!-- 目标目录不存在时跳过：3fp\build 是开发/验证目录，干净检出可能没有。 -->
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(_SyncTargetDll)"
          SkipUnchangedFiles="true" Condition="Exists('$(_SyncTargetDir)')" />
    <Message Importance="high" Condition="Exists('$(_SyncTargetDir)')"
             Text="已同步内核到验证副本: $(_SyncTargetDll)" />
  </Target>
</Project>
