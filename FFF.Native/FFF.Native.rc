// FFF.Native.dll 版本资源：对齐 PlayerApiVersion（PlayerApi.cpp）。
// FileVersion 便于在部署现场核对"这个 DLL 是哪个 API 版本编出来的"，
// 更新内核 API 时须同步递增此处主版本号。
#include <winver.h>

// 15 = PlayerApiVersion（FFF.Player.Api.h；FFF3FPConfiguration 新增 preferredAdapterIndex 字段）
#define VER_API 15

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_API,0,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FFF_Project"
            VALUE "FileDescription", "FFF.Native - 3FP media player kernel"
            VALUE "FileVersion", "15.0.0.0"
            VALUE "InternalName", "FFF.Native"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "FFF.Native.dll"
            VALUE "ProductName", "3FP Player Kernel"
            VALUE "ProductVersion", "0.3.0 (api 15)"
            VALUE "ApiVersion", "15"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
