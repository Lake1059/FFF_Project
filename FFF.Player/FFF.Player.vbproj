<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\tools\DiscRuntime.props" />
  <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
      <StartupObject>Sub Main</StartupObject>
      <UseWindowsForms>true</UseWindowsForms>
      <MyType>WindowsForms</MyType>
      <UseWPF>True</UseWPF>
      <!--<PublishReadyToRun>True</PublishReadyToRun>
      <PublishReadyToRunEmitSymbols>True</PublishReadyToRunEmitSymbols>-->
      <SelfContained>False</SelfContained>
      <!--<IncludeNativeLibrariesForSelfExtract>True</IncludeNativeLibrariesForSelfExtract>-->
      <!--<EnableCompressionInSingleFile>True</EnableCompressionInSingleFile>-->
      <Authors>1059 Studio</Authors>
      <Company>1059 Studio</Company>
      <AssemblyVersion>2026.10.12</AssemblyVersion>
      <FileVersion>2026.10.12</FileVersion>
      <Version>2026.10.12</Version>
      <Title>FFF.Player</Title>
      <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
      <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
      <PlatformTarget>x64</PlatformTarget>
      <Prefer32Bit>false</Prefer32Bit>
      <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
      <ApplicationIcon>ICO.ico</ApplicationIcon>
      <!-- 3FP native API version this host is built against.
           Single source of truth for the release check below: it is compared against the
           kernel's PlayerApiVersion, against the constant the host actually sends in
           FFF3FPConfiguration.version, and against the native DLL's own version resource,
           so none of them can drift apart silently.
           Bump ALL FOUR together when the configuration struct changes:
             1. kernel/FFF.Native/3FP/Api/PlayerApi.cpp   PlayerApiVersion
             2. FFF.Player/Core/播放器会话.vb              <> NNUI  (and .版本 = NNUI)
             3. FFF.Native/FFF.Native.rc                  VER_API + 三段 VALUE 字符串
             4. this property                                             -->
      <PlayerApiVersion>20</PlayerApiVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <LibassRuntimeDirectory>$(MSBuildProjectDirectory)\..\third_party\vcpkg_installed\x64-windows\debug\bin</LibassRuntimeDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <LibassRuntimeDirectory>$(MSBuildProjectDirectory)\..\third_party\vcpkg_installed\x64-windows\bin</LibassRuntimeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- 同进程回归需要构造 Friend 类型的 播放器会话 / 播放器画面控件 / 图片浏览控制器。
       此前 FFF.Player.Tests 看不见它们（编译器实测 BC30002 未定义类型"播放器会话"），
       所以体感那一路只能靠手点，无法留读数。开这一个可见性换回"测的就是跑的那份"。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="FFF.Player.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProductNative Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" />
    <DevelopmentRuntime Include="..\runtime\avcodec*.dll" />
    <DevelopmentRuntime Include="..\runtime\avformat*.dll" />
    <DevelopmentRuntime Include="..\runtime\avutil*.dll" />
    <DevelopmentRuntime Include="..\runtime\swresample*.dll" />
    <DevelopmentRuntime Include="..\runtime\swscale*.dll" />
    <DevelopmentRuntime Include="..\runtime\avfilter*.dll" />
    <LibassMainRuntime Include="$(LibassRuntimeDirectory)\ass-*.dll" />
    <LibassRuntime Include="@(LibassMainRuntime);$(LibassRuntimeDirectory)\brotlicommon.dll;$(LibassRuntimeDirectory)\brotlidec.dll;$(LibassRuntimeDirectory)\fribidi-0.dll;$(LibassRuntimeDirectory)\harfbuzz.dll" />
    <LibassRuntime Include="$(LibassRuntimeDirectory)\bz2d.dll;$(LibassRuntimeDirectory)\freetyped.dll;$(LibassRuntimeDirectory)\libpng16d.dll;$(LibassRuntimeDirectory)\zd.dll" Condition="'$(Configuration)' == 'Debug'" />
    <LibassRuntime Include="$(LibassRuntimeDirectory)\bz2.dll;$(LibassRuntimeDirectory)\freetype.dll;$(LibassRuntimeDirectory)\libpng16.dll;$(LibassRuntimeDirectory)\z.dll" Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Svg" Version="3.4.8" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\播放器按钮\播放.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Play.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\暂停.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Pause.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\停止.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Stop.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\倒退或上一个.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Previous.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\前进或下一个.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Next.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\打开.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Open.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\设置.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Settings.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\播放列表.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Playlist.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\剪辑区间.svg" LogicalName="FFF.Player.Resources.PlayerButtons.ClipRange.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\元数据.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Metadata.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\流选择.svg" LogicalName="FFF.Player.Resources.PlayerButtons.Streams.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFF.Native\FFF.Native.vcxproj" Condition="'$(MSBuildRuntimeType)' != 'Core'" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true">
      <!-- 原生项目仅支持 x64，直接构建宿主时也使用该平台。 -->
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <Content Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" Link="FFF.Native.dll">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
    <Content Include="@(LibassRuntime)" Link="%(Filename)%(Extension)">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- ════════════════════════════════════════════════════════════════════════════
       发布前的 API 版本一致性校验。

       为什么放在这里：宿主与内核共用一个 struct 布局，内核用
       `size >= sizeof(FFF3FPConfiguration)` **和** `version == PlayerApiVersion`
       双重校验。任一侧漂移，FFF3FP_Create 就返回 InvalidArgument —— 表现为
       "播放器起不来"。这属于**发布事故**，必须在打包阶段拦下，
       而不是等用户运行时才发现（那时只能给出一个含义不明的失败）。

       四处必须一致，本 target 把四者都读出来比对：
         ① 内核  PlayerApi.cpp          PlayerApiVersion
         ② 宿主  播放器会话.vb            <> NNUI / .版本 = NNUI
         ③ 本工程 <PlayerApiVersion>
         ④ 原生  FFF.Native.rc           VER_API 与 FileVersion/ApiVersion/(api NN) 三段字符串
       ════════════════════════════════════════════════════════════════════════════ -->
  <Target Name="VerifyPlayerApiVersion" BeforeTargets="Build;Publish">
    <PropertyGroup>
      <_PlayerApiCpp>$(MSBuildThisFileDirectory)..\FFF.Native\3FP\Api\PlayerApi.cpp</_PlayerApiCpp>
      <_PlayerSessionVb>$(MSBuildThisFileDirectory)Core\播放器会话.vb</_PlayerSessionVb>
    </PropertyGroup>

    <Error Condition="!Exists('$(_PlayerApiCpp)')"
           Text="版本校验找不到内核源文件：$(_PlayerApiCpp)" />
    <Error Condition="!Exists('$(_PlayerSessionVb)')"
           Text="版本校验找不到宿主源文件：$(_PlayerSessionVb)" />

    <!-- 内核声明的版本：constexpr std::uint32_t PlayerApiVersion = NN; -->
    <PropertyGroup>
      <_KernelApiVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerApiCpp)')),
        'PlayerApiVersion\s*=\s*(\d+)').Groups[1].Value)</_KernelApiVersion>
    </PropertyGroup>
    <!-- 宿主构造配置时实际写入的版本。宿主现在统一用常量 期望API版本，
         所以这里确认该常量确实被用于配置，而不是另一处硬编码的数字。 -->
    <PropertyGroup>
      <_HostSentVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerSessionVb)')),
        '原生播放器配置大小,\s*\.版本\s*=\s*(\w+)').Groups[1].Value)</_HostSentVersion>
    </PropertyGroup>
    <!-- 宿主硬校验的版本：常量 期望API版本 As UInteger = NNUI -->
    <PropertyGroup>
      <_HostCheckedVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerSessionVb)')),
        '期望API版本\s+As\s+UInteger\s*=\s*(\d+)UI').Groups[1].Value)</_HostCheckedVersion>
    </PropertyGroup>

    <Error Condition="'$(_KernelApiVersion)' == ''"
           Text="无法从 PlayerApi.cpp 解析 PlayerApiVersion。校验无法进行。" />
    <Error Condition="'$(_HostSentVersion)' == ''"
           Text="无法从 播放器会话.vb 解析配置写入的版本（'原生播放器配置大小, .版本 = ...'）。校验无法进行。" />
    <Error Condition="'$(_HostCheckedVersion)' == ''"
           Text="无法从 播放器会话.vb 解析 '期望API版本 As UInteger = NNUI'。校验无法进行。" />

    <Message Importance="high"
             Text="3FP API 版本：内核=$(_KernelApiVersion) 宿主发送=$(_HostSentVersion) 宿主校验=$(_HostCheckedVersion) 工程声明=$(PlayerApiVersion)" />

    <Error Condition="'$(_KernelApiVersion)' != '$(PlayerApiVersion)'"
           Text="发布中止：内核 API 版本 ($(_KernelApiVersion)) 与本工程声明 ($(PlayerApiVersion)) 不一致。请同步 FFF.Player.vbproj 的 &lt;PlayerApiVersion&gt;，并重新构建 FFF.Native。" />
    <Error Condition="'$(_HostCheckedVersion)' != '$(PlayerApiVersion)'"
           Text="发布中止：宿主常量 期望API版本 ($(_HostCheckedVersion)) 与本工程声明 ($(PlayerApiVersion)) 不一致。请同步 播放器会话.vb 的 'Friend Const 期望API版本 As UInteger = NNUI'。" />
    <!-- 宿主必须用常量而不是另一个字面量，否则三处声明就会各自漂移。 -->
    <Error Condition="'$(_HostSentVersion)' != '期望API版本'"
           Text="发布中止：配置里的版本写法为 '$(_HostSentVersion)'，应为常量 '期望API版本'。字面量会让版本号出现第四份副本。" />

    <!-- ④ 原生 DLL 自己的版本资源。rc 里 `#define VER_API` 和三段 VALUE 字符串都是
         字面量，不随 PlayerApi.cpp 走；部署现场偏偏就拿 FileVersion 核对"这个 DLL 是
         哪个 API 编出来的"。此前没人比对第四份 ⇒ 前三处同水、盘上件仍报旧号。 -->
    <PropertyGroup>
      <_NativeResourceRc>$(MSBuildThisFileDirectory)..\FFF.Native\FFF.Native.rc</_NativeResourceRc>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NativeResourceRc)')"
           Text="版本校验找不到原生版本资源：$(_NativeResourceRc)" />
    <PropertyGroup>
      <_RcVerApi>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '\#define\s+VER_API\s+(\d+)').Groups[1].Value)</_RcVerApi>
      <_RcFileVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '"FileVersion",\s*"(\d+)').Groups[1].Value)</_RcFileVersion>
      <_RcApiVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '"ApiVersion",\s*"(\d+)').Groups[1].Value)</_RcApiVersion>
      <_RcProductApi>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '\(api (\d+)\)').Groups[1].Value)</_RcProductApi>
    </PropertyGroup>
    <!-- 解析不出就必须拦：少一段字符串的话，这个门会退化成"只比 VER_API"的半瞎门。 -->
    <Error Condition="'$(_RcVerApi)' == '' Or '$(_RcFileVersion)' == '' Or
                     '$(_RcApiVersion)' == '' Or '$(_RcProductApi)' == ''"
           Text="无法从 FFF.Native.rc 解析版本号（应同时找到 VER_API、FileVersion、ApiVersion 与 &quot;(api NN)&quot;）。版本校验无法进行。" />
    <Message Importance="high"
             Text="3FP API 版本（第四份：原生版本资源）：VER_API=$(_RcVerApi) FileVersion=$(_RcFileVersion) ApiVersion=$(_RcApiVersion) ProductVersion 内 api=$(_RcProductApi)" />
    <Error Condition="'$(_RcVerApi)' != '$(PlayerApiVersion)'"
           Text="发布中止：FFF.Native.rc 的 VER_API ($(_RcVerApi)) 与 API 版本 ($(PlayerApiVersion)) 不一致。改 rc 主版本号后必须重新构建 FFF.Native。" />
    <Error Condition="'$(_RcFileVersion)' != '$(PlayerApiVersion)'"
           Text="发布中止：FFF.Native.rc 的 FileVersion 字符串 ($(_RcFileVersion)) 与 API 版本 ($(PlayerApiVersion)) 不一致 —— 部署现场读的就是这一段。" />
    <Error Condition="'$(_RcApiVersion)' != '$(PlayerApiVersion)'"
           Text="发布中止：FFF.Native.rc 的 ApiVersion 字符串 ($(_RcApiVersion)) 与 API 版本 ($(PlayerApiVersion)) 不一致。" />
    <Error Condition="'$(_RcProductApi)' != '$(PlayerApiVersion)'"
           Text="发布中止：FFF.Native.rc 的 ProductVersion &quot;(api NN)&quot; ($(_RcProductApi)) 与 API 版本 ($(PlayerApiVersion)) 不一致。" />
  </Target>

  <!-- 打包前确认内核结构体大小与宿主一致：仅比对版本号不够，内核还会校验 size。 -->
  <Target Name="VerifyPlayerConfigSize" BeforeTargets="Publish"
          DependsOnTargets="VerifyPlayerApiVersion">
    <PropertyGroup>
      <_PlayerApiHeader>$(MSBuildThisFileDirectory)..\FFF.Native\3FP\Api\FFF.Player.Api.h</_PlayerApiHeader>
      <_HostInteropVb>$(MSBuildThisFileDirectory)Interop\播放器原生接口.vb</_HostInteropVb>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PlayerApiHeader)')"
           Text="结构体校验找不到内核头文件：$(_PlayerApiHeader)" />
    <Error Condition="!Exists('$(_HostInteropVb)')"
           Text="结构体校验找不到宿主互操作文件：$(_HostInteropVb)" />

    <!-- 数 FFF3FPConfiguration 里的字段：从 struct 起到 '};' 止。
         必须排除注释行 —— 结构体里有多行 '// ...' 说明，早期版本把它们也计进去，
         于是内核报 25 而实测只有 22，检查自己产生了假阳性。 -->
    <PropertyGroup>
      <_KernelConfigBody>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerApiHeader)')),
        '(?s)struct FFF3FPConfiguration\s*\{(.*?)\n\s*\};').Groups[1].Value)</_KernelConfigBody>
      <_KernelConfigFields>$([System.Text.RegularExpressions.Regex]::Matches(
        '$(_KernelConfigBody)', '(?m)^\s+(?!//)\S[^;]*;').Count)</_KernelConfigFields>
    </PropertyGroup>
    <!-- 宿主 原生播放器配置 的字段数 -->
    <PropertyGroup>
      <_HostConfigBody>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_HostInteropVb)')),
        '(?s)Structure 原生播放器配置(.*?)End Structure').Groups[1].Value)</_HostConfigBody>
      <_HostConfigFields>$([System.Text.RegularExpressions.Regex]::Matches(
        '$(_HostConfigBody)', '(?m)^\s+Public \w+ As ').Count)</_HostConfigFields>
    </PropertyGroup>

    <Error Condition="'$(_KernelConfigFields)' == '' Or '$(_KernelConfigFields)' == '0'"
           Text="无法解析 FFF3FPConfiguration 的字段。结构体校验无法进行。" />
    <Error Condition="'$(_HostConfigFields)' == '' Or '$(_HostConfigFields)' == '0'"
           Text="无法解析 原生播放器配置 的字段。结构体校验无法进行。" />

    <Message Importance="high"
             Text="3FP 配置结构体字段数：内核=$(_KernelConfigFields) 宿主=$(_HostConfigFields)" />

    <Error Condition="'$(_KernelConfigFields)' != '$(_HostConfigFields)'"
           Text="发布中止：配置结构体字段数不一致（内核 $(_KernelConfigFields) vs 宿主 $(_HostConfigFields)）。宿主会因 size 不足被 FFF3FP_Create 拒绝。请在 原生播放器接口.vb 的 原生播放器配置 末尾补齐缺失字段。" />
  </Target>

  <Target Name="CopyNativeRuntime" AfterTargets="Build">
    <Error Condition="!Exists('..\FFF.Native\x64\$(Configuration)\FFF.Native.dll')" Text="请先构建 FFF.Native 的 x64 $(Configuration) 配置。" />
    <Error Condition="'@(LibassMainRuntime)' == ''" Text="缺少 libass 运行库；请先运行 tools\准备Libass.ps1。" />
    <Copy SourceFiles="@(ProductNative);@(DevelopmentRuntime);@(LibassRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- 发布目录必须拿到**全部**运行期原生库。
       这里此前只拷贝了 ProductNative 与 LibassRuntime，漏掉 @(DevelopmentRuntime)
       —— 也就是 FFmpeg 的 avcodec/avformat/avutil/swresample/swscale/avfilter。
       结果是 build 输出目录能跑、publish 出来的包缺少 FFmpeg，启动即失败。
       与 CopyNativeRuntime 保持一致，并显式校验缺失情况。 -->
  <Target Name="CopyProductNativeToPublish" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
    <Error Condition="'@(DevelopmentRuntime)' == ''"
           Text="找不到 FFmpeg 运行库（..\runtime\av*.dll 等）。请确认 kernel\runtime 已就位后再发布。" />
    <Copy SourceFiles="@(ProductNative);@(DevelopmentRuntime);@(LibassRuntime)"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- 侵权护栏（tripwire）：旧商标私有 DLL 不得进发布目录。
       2026-10-13 P1.5 曾以"私有 DLL 不在树里⇒护栏无用"删除本 target；
       2026-10-14 裁定反转——中性模块 FFF.HDRdp.Test.dll 自此随包发布，
       发布目录重新变成"可能被误放入旧件"的地方，护栏必须恢复。
       条件精确匹配旧名：新名 FFF.HDRdp.Test.dll 不受影响（刻意放行）。 -->
  <Target Name="RejectPrivateColorExtensionPublish" AfterTargets="ComputeFilesToPublish" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <PrivateColorExtension Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'FFF.DolbyVision.Test.dll'" />
    </ItemGroup>
    <Error Condition="'@(PrivateColorExtension)' != ''" Text="侵权护栏：旧商标私有 DLL FFF.DolbyVision.Test.dll 不得发布或打包；中性模块请使用 FFF.HDRdp.Test.dll。" />
  </Target>

  <ItemGroup>
    <Reference Include="LakeUI">
      <HintPath>..\..\LakeUI\LakeUI\bin\Debug\net10.0-windows10.0.17763.0\LakeUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UI\播放器画面控件.vb" />
    <EmbeddedResource Remove="F:\Git\3F_Project\tools\..\third_party\vcpkg_installed\x64-windows\share\libbluray\copyright" />
    <EmbeddedResource Remove="F:\Git\3F_Project\tools\..\third_party\vcpkg_installed\x64-windows\share\libiconv\copyright" />
    <EmbeddedResource Remove="F:\Git\3F_Project\tools\..\third_party\vcpkg_installed\x64-windows\share\libudfread\copyright" />
    <EmbeddedResource Remove="F:\Git\3F_Project\tools\..\third_party\vcpkg_installed\x64-windows\share\libxml2\copyright" />
    <Compile Include="UI\播放器画面控件.vb">
      <SubType>Code</SubType>
    </Compile>
    <Content Include="ICO.ico" />
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
