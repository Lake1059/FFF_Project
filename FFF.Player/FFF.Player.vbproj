<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\third_party\FFmpegRuntime.props" />
  <Import Project="..\third_party\DiscRuntime.props" />
  <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <NetTFM Condition="'$(NetTFM)' == ''">net11.0-windows10.0.19041.0</NetTFM>
      <TargetFramework>$(NetTFM)</TargetFramework>
      <!-- Native FFF.Native implements SMTC. The managed player does not need the WinRT projection. -->
      <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
      <!-- Suppress package symbols found beside the explicit Mathematics reference in release bundles. -->
      <AllowedReferenceRelatedFileExtensions Condition="'$(PublishSingleFile)' == 'true' And '$(DebugSymbols)' == 'false'">.xml;.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
      <LakeUIDesignerBackend>DX11</LakeUIDesignerBackend>
      <StartupObject>Sub Main</StartupObject>
      <UseWindowsForms>true</UseWindowsForms>
      <MyType>WindowsForms</MyType>
      <UseWPF>True</UseWPF>
      <!--<PublishReadyToRun>True</PublishReadyToRun>
      <PublishReadyToRunEmitSymbols>True</PublishReadyToRunEmitSymbols>-->
      <SelfContained>False</SelfContained>
      <!--<IncludeNativeLibrariesForSelfExtract>True</IncludeNativeLibrariesForSelfExtract>-->
      <!--<EnableCompressionInSingleFile>True</EnableCompressionInSingleFile>-->
      <Authors>1059 Studio</Authors>
      <Company>1059 Studio</Company>
      <Copyright>Copyright (c) 2026 1059 Studio</Copyright>
      <AssemblyVersion>2026.11.23</AssemblyVersion>
      <FileVersion>2026.11.23</FileVersion>
      <Version>2026.11.23</Version>
      <Title>FFF.Player</Title>
      <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
      <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
      <PlatformTarget>x64</PlatformTarget>
      <Prefer32Bit>false</Prefer32Bit>
      <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
      <ApplicationIcon>ICO.ico</ApplicationIcon>

      <PlayerApiVersion>20</PlayerApiVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <LibassRuntimeDirectory>$(MSBuildProjectDirectory)\..\third_party\vcpkg_installed\x64-windows\debug\bin</LibassRuntimeDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <LibassRuntimeDirectory>$(MSBuildProjectDirectory)\..\third_party\vcpkg_installed\x64-windows\bin</LibassRuntimeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="FFF.Player.Tests" />
  </ItemGroup>

  <!-- Python is still external. Only the scripts and notices needed to assemble
       an AI subtitle pack are built into the host (including single-file publish). -->
  <ItemGroup>
    <EmbeddedResource Include="AI字幕\Worker\*.py;AI字幕\Worker\*.txt"
                      WithCulture="false" LogicalName="AiSubtitles.Pack/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\LICENSE.txt"
                      WithCulture="false" LogicalName="AiSubtitles.Pack/LICENSE.txt" />
    <EmbeddedResource Include="..\licenses\ai\*.txt"
                      WithCulture="false" LogicalName="AiSubtitles.Pack/licenses/ai/%(Filename)%(Extension)" />
    <None Update="ICO.ico" CopyToOutputDirectory="PreserveNewest" Condition="'$(PublishSingleFile)' != 'true'" />
    <None Include="..\LICENSE.txt;..\licenses\NOTICE;..\licenses\LICENSING.md;..\licenses\THIRD-PARTY-NOTICES.md"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(PublishSingleFile)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProductNative Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" />
    <!-- RAW 内核用 /DELAYLOAD 依赖 libraw.dll，运行时从 FFF.Native.dll 所在目录加载。
         必须与产品内核一起进散装输出与发布目录；单文件模式另见下方 PublishSingleFile 的 Content。 -->
    <LibRawRuntime Include="..\third_party\libraw\bin\x64\libraw.dll" Condition="Exists('..\third_party\libraw\bin\x64\libraw.dll')" />
    <!-- Side-lane helper is optional: when it has not been built the kernel
         degrades to the in-process lane, so an empty item must not break build. -->
    <PrefetchHelper Include="..\build\$(Configuration)\FFF.PrefetchHost.exe"
                    Condition="'$(PublishSingleFile)' != 'true' and Exists('..\build\$(Configuration)\FFF.PrefetchHost.exe')" />
    <LibassMainRuntime Include="$(LibassRuntimeDirectory)\ass-*.dll" />
    <LibassRuntime Include="@(LibassMainRuntime);$(LibassRuntimeDirectory)\brotlicommon.dll;$(LibassRuntimeDirectory)\brotlidec.dll;$(LibassRuntimeDirectory)\fribidi-0.dll;$(LibassRuntimeDirectory)\harfbuzz.dll" />
    <LibassRuntime Include="$(LibassRuntimeDirectory)\bz2d.dll;$(LibassRuntimeDirectory)\freetyped.dll;$(LibassRuntimeDirectory)\libpng16d.dll;$(LibassRuntimeDirectory)\zd.dll" Condition="'$(Configuration)' == 'Debug'" />
    <LibassRuntime Include="$(LibassRuntimeDirectory)\bz2.dll;$(LibassRuntimeDirectory)\freetype.dll;$(LibassRuntimeDirectory)\libpng16.dll;$(LibassRuntimeDirectory)\z.dll" Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <!-- O4（2026-10-30）：图标改为烘焙 PNG 后，运行时代码不再直接使用 Svg（及传递依赖 ExCSS）。
       现无改色/换肤通路（11 个 SVG 描边写死 #dcdcdc，无 currentColor/CSS 变量）；改图标时重跑 bake_icons.ps1。
       【2026-11-01 修复】曾移除本 PackageReference 以减包体，但在含 upstream PR #49 的合并构建
       （PublishReadyToRun）下触发启动 ~417ms CLR FailFast（0xC0000602，三无：stderr/事件日志/WER 全空）；
       恢复引用后消融验证双向成立（移除=崩、恢复=活、事后拷 DLL 不救，属构建期差异而非运行时缺文件）。
       故保留该引用（代价仅输出目录被动文件 ~0.6MB，启动路径不加载），烘焙收益全部保留。 -->
  <PackageReference Include="Svg" Version="3.4.8" />
    <!-- The Windows-specific Mathematics asset only adds WinRT overloads that
         3FP and LakeUI do not use. Use the same package's portable assembly. -->
    <PackageReference Include="Vortice.Mathematics" Version="2.1.0" ExcludeAssets="compile;runtime" GeneratePathProperty="true" />
    <Reference Include="Vortice.Mathematics" HintPath="$(PkgVortice_Mathematics)\lib\net10.0\Vortice.Mathematics.dll" Private="true" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- O4（2026-10-30）：按钮图标改为构建期烘焙的 PNG（设计源 svg 仍留在仓内，不进包）。
         依据 imgperf/o3o4_analysis.md §2.4：11/11 像素级一致，运行时不再需要 Svg/ExCSS/Xml 首触。 -->
    <None Include="Resources\播放器按钮\*.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\播放.png" LogicalName="FFF.Player.Resources.PlayerButtons.Play.png" />
    <EmbeddedResource Include="Resources\播放器按钮\暂停.png" LogicalName="FFF.Player.Resources.PlayerButtons.Pause.png" />
    <EmbeddedResource Include="Resources\播放器按钮\停止.png" LogicalName="FFF.Player.Resources.PlayerButtons.Stop.png" />
    <EmbeddedResource Include="Resources\播放器按钮\倒退或上一个.png" LogicalName="FFF.Player.Resources.PlayerButtons.Previous.png" />
    <EmbeddedResource Include="Resources\播放器按钮\前进或下一个.png" LogicalName="FFF.Player.Resources.PlayerButtons.Next.png" />
    <EmbeddedResource Include="Resources\播放器按钮\打开.png" LogicalName="FFF.Player.Resources.PlayerButtons.Open.png" />
    <EmbeddedResource Include="Resources\播放器按钮\设置.png" LogicalName="FFF.Player.Resources.PlayerButtons.Settings.png" />
    <EmbeddedResource Include="Resources\播放器按钮\播放列表.png" LogicalName="FFF.Player.Resources.PlayerButtons.Playlist.png" />
    <EmbeddedResource Include="Resources\播放器按钮\剪辑区间.png" LogicalName="FFF.Player.Resources.PlayerButtons.ClipRange.png" />
    <EmbeddedResource Include="Resources\播放器按钮\元数据.png" LogicalName="FFF.Player.Resources.PlayerButtons.Metadata.png" />
    <EmbeddedResource Include="Resources\播放器按钮\流选择.png" LogicalName="FFF.Player.Resources.PlayerButtons.Streams.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFF.Native\FFF.Native.vcxproj" Condition="'$(MSBuildRuntimeType)' != 'Core'" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true">

      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PlayerBundledNative Include="@(ProductNative);@(LibRawRuntime);@(LibassRuntime)" />
    <PlayerNativeRuntime Include="@(PlayerBundledNative);@(PrefetchHelper)" />
    <PlayerNativeRuntime Include="@(DevelopmentRuntime)" Condition="'$(BodyOnly)' != 'true' and '$(PublishSingleFile)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <Content Include="@(PlayerBundledNative)" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyPlayerApiVersion" BeforeTargets="Build;Publish">
    <PropertyGroup>
      <_PlayerApiCpp>$(MSBuildThisFileDirectory)..\FFF.Native\3FP\Api\PlayerApi.cpp</_PlayerApiCpp>
      <_PlayerSessionVb>$(MSBuildThisFileDirectory)Core\播放器会话.vb</_PlayerSessionVb>
    </PropertyGroup>

    <Error Condition="!Exists('$(_PlayerApiCpp)')" Text="版本校验找不到内核源文件：$(_PlayerApiCpp)" />
    <Error Condition="!Exists('$(_PlayerSessionVb)')" Text="版本校验找不到宿主源文件：$(_PlayerSessionVb)" />


    <PropertyGroup>
      <_KernelApiVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerApiCpp)')),
        'PlayerApiVersion\s*=\s*(\d+)').Groups[1].Value)</_KernelApiVersion>
    </PropertyGroup>

    <PropertyGroup>
      <_HostSentVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerSessionVb)')),
        '原生播放器配置大小,\s*\.版本\s*=\s*(\w+)').Groups[1].Value)</_HostSentVersion>
    </PropertyGroup>

    <PropertyGroup>
      <_HostCheckedVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerSessionVb)')),
        '期望API版本\s+As\s+UInteger\s*=\s*(\d+)UI').Groups[1].Value)</_HostCheckedVersion>
    </PropertyGroup>

    <Error Condition="'$(_KernelApiVersion)' == ''" Text="无法从 PlayerApi.cpp 解析 PlayerApiVersion。校验无法进行。" />
    <Error Condition="'$(_HostSentVersion)' == ''" Text="无法从 播放器会话.vb 解析配置写入的版本（'原生播放器配置大小, .版本 = ...'）。校验无法进行。" />
    <Error Condition="'$(_HostCheckedVersion)' == ''" Text="无法从 播放器会话.vb 解析 '期望API版本 As UInteger = NNUI'。校验无法进行。" />

    <Message Importance="high" Text="3FP API 版本：内核=$(_KernelApiVersion) 宿主发送=$(_HostSentVersion) 宿主校验=$(_HostCheckedVersion) 工程声明=$(PlayerApiVersion)" />

    <Error Condition="'$(_KernelApiVersion)' != '$(PlayerApiVersion)'" Text="发布中止：内核 API 版本 ($(_KernelApiVersion)) 与本工程声明 ($(PlayerApiVersion)) 不一致。请同步 FFF.Player.vbproj 的 &lt;PlayerApiVersion&gt;，并重新构建 FFF.Native。" />
    <Error Condition="'$(_HostCheckedVersion)' != '$(PlayerApiVersion)'" Text="发布中止：宿主常量 期望API版本 ($(_HostCheckedVersion)) 与本工程声明 ($(PlayerApiVersion)) 不一致。请同步 播放器会话.vb 的 'Friend Const 期望API版本 As UInteger = NNUI'。" />

    <Error Condition="'$(_HostSentVersion)' != '期望API版本'" Text="发布中止：配置里的版本写法为 '$(_HostSentVersion)'，应为常量 '期望API版本'。字面量会让版本号出现第四份副本。" />


    <PropertyGroup>
      <_NativeResourceRc>$(MSBuildThisFileDirectory)..\FFF.Native\FFF.Native.rc</_NativeResourceRc>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NativeResourceRc)')" Text="版本校验找不到原生版本资源：$(_NativeResourceRc)" />
    <PropertyGroup>
      <_RcVerApi>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '\#define\s+VER_API\s+(\d+)').Groups[1].Value)</_RcVerApi>
      <_RcFileVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '"FileVersion",\s*"(\d+)').Groups[1].Value)</_RcFileVersion>
      <_RcApiVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '"ApiVersion",\s*"(\d+)').Groups[1].Value)</_RcApiVersion>
      <_RcProductApi>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '\(api (\d+)\)').Groups[1].Value)</_RcProductApi>
    </PropertyGroup>

    <Error Condition="'$(_RcVerApi)' == '' Or '$(_RcFileVersion)' == '' Or&#xD;&#xA;                     '$(_RcApiVersion)' == '' Or '$(_RcProductApi)' == ''" Text="无法从 FFF.Native.rc 解析版本号（应同时找到 VER_API、FileVersion、ApiVersion 与 &quot;(api NN)&quot;）。版本校验无法进行。" />
    <Message Importance="high" Text="3FP API 版本（第四份：原生版本资源）：VER_API=$(_RcVerApi) FileVersion=$(_RcFileVersion) ApiVersion=$(_RcApiVersion) ProductVersion 内 api=$(_RcProductApi)" />
    <Error Condition="'$(_RcVerApi)' != '$(PlayerApiVersion)'" Text="发布中止：FFF.Native.rc 的 VER_API ($(_RcVerApi)) 与 API 版本 ($(PlayerApiVersion)) 不一致。改 rc 主版本号后必须重新构建 FFF.Native。" />
    <Error Condition="'$(_RcFileVersion)' != '$(PlayerApiVersion)'" Text="发布中止：FFF.Native.rc 的 FileVersion 字符串 ($(_RcFileVersion)) 与 API 版本 ($(PlayerApiVersion)) 不一致 —— 部署现场读的就是这一段。" />
    <Error Condition="'$(_RcApiVersion)' != '$(PlayerApiVersion)'" Text="发布中止：FFF.Native.rc 的 ApiVersion 字符串 ($(_RcApiVersion)) 与 API 版本 ($(PlayerApiVersion)) 不一致。" />
    <Error Condition="'$(_RcProductApi)' != '$(PlayerApiVersion)'" Text="发布中止：FFF.Native.rc 的 ProductVersion &quot;(api NN)&quot; ($(_RcProductApi)) 与 API 版本 ($(PlayerApiVersion)) 不一致。" />
  </Target>


  <Target Name="VerifyPlayerConfigSize" BeforeTargets="Publish" DependsOnTargets="VerifyPlayerApiVersion">
    <PropertyGroup>
      <_PlayerApiHeader>$(MSBuildThisFileDirectory)..\FFF.Native\3FP\Api\FFF.Player.Api.h</_PlayerApiHeader>
      <_HostInteropVb>$(MSBuildThisFileDirectory)Interop\播放器原生接口.vb</_HostInteropVb>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PlayerApiHeader)')" Text="结构体校验找不到内核头文件：$(_PlayerApiHeader)" />
    <Error Condition="!Exists('$(_HostInteropVb)')" Text="结构体校验找不到宿主互操作文件：$(_HostInteropVb)" />


    <PropertyGroup>
      <_KernelConfigBody>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerApiHeader)')),
        '(?s)struct FFF3FPConfiguration\s*\{(.*?)\n\s*\};').Groups[1].Value)</_KernelConfigBody>
      <_KernelConfigFields>$([System.Text.RegularExpressions.Regex]::Matches(
        '$(_KernelConfigBody)', '(?m)^\s+(?!//)\S[^;]*;').Count)</_KernelConfigFields>
    </PropertyGroup>

    <PropertyGroup>
      <_HostConfigBody>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_HostInteropVb)')),
        '(?s)Structure 原生播放器配置(.*?)End Structure').Groups[1].Value)</_HostConfigBody>
      <_HostConfigFields>$([System.Text.RegularExpressions.Regex]::Matches(
        '$(_HostConfigBody)', '(?m)^\s+Public \w+ As ').Count)</_HostConfigFields>
    </PropertyGroup>

    <Error Condition="'$(_KernelConfigFields)' == '' Or '$(_KernelConfigFields)' == '0'" Text="无法解析 FFF3FPConfiguration 的字段。结构体校验无法进行。" />
    <Error Condition="'$(_HostConfigFields)' == '' Or '$(_HostConfigFields)' == '0'" Text="无法解析 原生播放器配置 的字段。结构体校验无法进行。" />

    <Message Importance="high" Text="3FP 配置结构体字段数：内核=$(_KernelConfigFields) 宿主=$(_HostConfigFields)" />

    <Error Condition="'$(_KernelConfigFields)' != '$(_HostConfigFields)'" Text="发布中止：配置结构体字段数不一致（内核 $(_KernelConfigFields) vs 宿主 $(_HostConfigFields)）。宿主会因 size 不足被 FFF3FP_Create 拒绝。请在 原生播放器接口.vb 的 原生播放器配置 末尾补齐缺失字段。" />
  </Target>

  <Target Name="VerifyPlayerNativeRuntime" BeforeTargets="CopyNativeRuntime;CopyProductNativeToPublish;ComputeFilesToPublish">
    <Error Condition="!Exists('@(ProductNative)')" Text="请先构建 FFF.Native 的 x64 $(Configuration) 配置。" />
    <Error Condition="'@(LibassMainRuntime)' == ''" Text="缺少 libass 运行库；请先运行 tools\准备Libass.ps1。" />
    <Error Condition="'@(LibRawRuntime)' == ''" Text="缺少 LibRaw 运行库；请先运行 tools\准备LibRaw.ps1。" />
  </Target>

  <Target Name="CopyNativeRuntime" AfterTargets="Build">
    <Copy SourceFiles="@(PlayerNativeRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyProductNativeToPublish" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
    <Copy SourceFiles="@(PlayerNativeRuntime)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RejectPrivateColorExtensionPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <PrivateColorExtension Include="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)', '(?i)(ExternalModule.*|\.Test)\.dll$'))" />
    </ItemGroup>
    <Error Condition="'@(PrivateColorExtension)' != ''" Text="外部模块 DLL 不得发布或打包：@(PrivateColorExtension)" />
  </Target>

  <!-- Check the SDK's final bundle inputs, not the reused build output or the
       directory left after publish. Native DLLs must have bundle-root paths. -->
  <Target Name="VerifyPlayerBundle" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_UnexpectedBundleDll Include="@(FilesToBundle)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(FilesToBundle.Filename)%(FilesToBundle.Extension)', '(?i)^((av(codec|filter|format|util)|sw(resample|scale))(-\d+)?\.dll|FFF\.PrefetchHost\.exe)$'))" />
      <_BundledWinRTProjection Include="@(FilesToBundle)"
          Condition="'%(FilesToBundle.Filename)%(FilesToBundle.Extension)' == 'Microsoft.Windows.SDK.NET.dll' Or '%(FilesToBundle.Filename)%(FilesToBundle.Extension)' == 'WinRT.Runtime.dll'" />
      <_BundledPath Include="@(FilesToBundle->'%(RelativePath)')" />
      <_PlayerBundleAssembly Include="@(FilesToBundle)" Condition="'%(FilesToBundle.RelativePath)' == 'FFF.Player.dll'" />
      <_RequiredAiResource Include="asr_worker.py;qwen3_ort.py;AI字幕包声明.txt;LICENSE.txt" />
      <_RequiredAiResource Include="licenses/ai/Apache-2.0.txt;licenses/ai/BSD-3-Clause.txt;licenses/ai/MIT.txt;licenses/ai/NOTICE.txt;licenses/ai/PSF-2.0.txt" />
      <_MissingBundlePath Include="@(PlayerBundledNative->'%(Filename)%(Extension)');@(DiscRuntime->'%(Filename)%(Extension)')" Exclude="@(_BundledPath)" />
    </ItemGroup>
    <Error Condition="'@(_UnexpectedBundleDll)' != ''" Text="单文件不得内置外部 FFmpeg 或预取助手：@(_UnexpectedBundleDll)" />
    <Error Condition="'@(_MissingBundlePath)' != ''" Text="单文件缺少原生 DLL：@(_MissingBundlePath)" />
    <Error Condition="'@(_BundledWinRTProjection)' != ''" Text="3FP 单文件包含意外的 WinRT 投影：@(_BundledWinRTProjection)" />
    <Error Condition="'@(_PlayerBundleAssembly->Count())' != '1'" Text="单文件必须包含一份 FFF.Player.dll。" />
    <VerifyPlayerAiResources AssemblyFile="@(_PlayerBundleAssembly->'%(FullPath)')" RequiredResources="@(_RequiredAiResource)" />
  </Target>

  <UsingTask TaskName="VerifyPlayerAiResources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyFile ParameterType="System.String" Required="true" />
      <RequiredResources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Reflection" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var assembly = Assembly.Load(File.ReadAllBytes(AssemblyFile));
        var embedded = new HashSet<string>(assembly.GetManifestResourceNames(), StringComparer.Ordinal);
        foreach (var item in RequiredResources)
        {
            var name = "AiSubtitles.Pack/" + item.ItemSpec;
            if (!embedded.Contains(name) ||
                assembly.GetManifestResourceInfo(name).ResourceLocation !=
                    (ResourceLocation.Embedded | ResourceLocation.ContainedInManifestFile))
                Log.LogError("单文件缺少 AI 字幕资源 {0}", item.ItemSpec);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- WinRT 投影配对护栏：随包托管件引用投影件时必须同时存在。 -->
  <UsingTask TaskName="AssertWindowsSdkProjectionPairing" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ScanDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var selfNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "Microsoft.Windows.SDK.NET.dll", "WinRT.Runtime.dll" };
        bool needSdk = false, needRt = false, hasSdk = false, hasRt = false;
        foreach (var file in Directory.GetFiles(ScanDirectory, "*.dll"))
        {
            var fileName = Path.GetFileName(file);
            if (fileName.Equals("Microsoft.Windows.SDK.NET.dll", StringComparison.OrdinalIgnoreCase)) { hasSdk = true; continue; }
            if (fileName.Equals("WinRT.Runtime.dll", StringComparison.OrdinalIgnoreCase)) { hasRt = true; continue; }
            var text = Encoding.GetEncoding(28591).GetString(File.ReadAllBytes(file));
            if (text.Contains("Microsoft.Windows.SDK.NET")) needSdk = true;
            if (text.Contains("WinRT.Runtime")) needRt = true;
        }
        if (needSdk && !hasSdk)
            Log.LogError("WinRT 投影配对护栏：随包托管件引用了 Microsoft.Windows.SDK.NET，但交付缺少该文件——剔除/漏拷会静默破坏运行时，请恢复或先解除引用闭包。", Array.Empty<object>());
        if (needRt && !hasRt)
            Log.LogError("WinRT 投影配对护栏：随包托管件引用了 WinRT.Runtime，但交付缺少该文件——剔除/漏拷会静默破坏运行时，请恢复或先解除引用闭包。", Array.Empty<object>());
        ]]>
      </Code>
    </Task>
  </UsingTask>
  <Target Name="AssertWindowsSdkProjectionPairing" AfterTargets="Build">
    <AssertWindowsSdkProjectionPairing ScanDirectory="$(OutDir)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\LakeUI\LakeUI\LakeUI.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UI\播放器画面控件.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>


  <Import Project="..\..\LakeUI\LakeUI\buildTransitive\LakeUI.targets" />

</Project>
