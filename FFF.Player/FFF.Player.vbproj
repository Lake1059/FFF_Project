<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\tools\DiscRuntime.props" />
  <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <!-- TFM 就地定义：默认与上游一致（.NET 10）。切 .NET 11 用 -p:NetTFM=net11.0-windows10.0.26100.0 -->
      <NetTFM Condition="'$(NetTFM)' == ''">net10.0-windows</NetTFM>
      <TargetFramework>$(NetTFM)</TargetFramework>
      <!-- LakeUI 是外部商业兄弟仓，构建节奏独立，单独一个 TFM 参数 -->
      <LakeUITfm Condition="'$(LakeUITfm)' == ''">net10.0-windows10.0.17763.0</LakeUITfm>
      <!-- LakeUI 产物配置：默认 Release + R2R（兄弟仓以 dotnet publish -p:PublishReadyToRun=true
           产出带本机码的预编译件，宿主启动免去 LakeUI 全量 JIT）。
           回退旧行为（Debug IL 产物）：-p:LakeUIConfig=Debug -->
      <LakeUIConfig Condition="'$(LakeUIConfig)' == ''">Release</LakeUIConfig>
      <StartupObject>Sub Main</StartupObject>
      <UseWindowsForms>true</UseWindowsForms>
      <MyType>WindowsForms</MyType>
      <UseWPF>True</UseWPF>
      <!--<PublishReadyToRun>True</PublishReadyToRun>
      <PublishReadyToRunEmitSymbols>True</PublishReadyToRunEmitSymbols>-->
      <SelfContained>False</SelfContained>
      <!--<IncludeNativeLibrariesForSelfExtract>True</IncludeNativeLibrariesForSelfExtract>-->
      <!--<EnableCompressionInSingleFile>True</EnableCompressionInSingleFile>-->
      <Authors>1059 Studio</Authors>
      <Company>1059 Studio</Company>
      <Copyright>Copyright (c) 2026 1059 Studio</Copyright>
      <AssemblyVersion>2026.11.5</AssemblyVersion>
      <FileVersion>2026.11.5</FileVersion>
      <Version>2026.11.5</Version>
      <Title>FFF.Player</Title>
      <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
      <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
      <PlatformTarget>x64</PlatformTarget>
      <Prefer32Bit>false</Prefer32Bit>
      <SupportedOSPlatformVersion Condition="$(NetTFM.EndsWith('-windows'))">7.0</SupportedOSPlatformVersion>
      <SupportedOSPlatformVersion Condition="!$(NetTFM.EndsWith('-windows'))">10.0.19041.0</SupportedOSPlatformVersion>
      <ApplicationIcon>ICO.ico</ApplicationIcon>

      <PlayerApiVersion>20</PlayerApiVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <LibassRuntimeDirectory>$(MSBuildProjectDirectory)\..\third_party\vcpkg_installed\x64-windows\debug\bin</LibassRuntimeDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <LibassRuntimeDirectory>$(MSBuildProjectDirectory)\..\third_party\vcpkg_installed\x64-windows\bin</LibassRuntimeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="FFF.Player.Tests" />
  </ItemGroup>

  <!-- AI 字幕包下载器要能就地生成扩展包：worker 脚本随播放器部署（包契约要求
       worker 在包根，下载器从程序目录的这份复制过去）。源=kernel/tools 的维护版。
       qwen3_ort.py 同理：NPU 包的三段 OpenVINO 推理实现，须与 worker 同级（docs/157）。 -->
  <ItemGroup>
    <None Include="..\tools\ai-subtitles\asr_worker.py">
      <Link>ai-subtitles\asr_worker.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\tools\ai-subtitles\qwen3_ort.py">
      <Link>ai-subtitles\qwen3_ort.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\tools\ai-subtitles\AI字幕包声明.txt">
      <Link>ai-subtitles\AI字幕包声明.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\LICENSE.txt">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\NOTICE">
      <Link>NOTICE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\LICENSING.md">
      <Link>LICENSING.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\THIRD-PARTY-NOTICES.md">
      <Link>THIRD-PARTY-NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- AI 扩展包第三方许可原文：随播放器部署到 licenses\ai，下载器再复制进包。 -->
    <None Include="..\licenses\ai\Apache-2.0.txt">
      <Link>licenses\ai\Apache-2.0.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\licenses\ai\MIT.txt">
      <Link>licenses\ai\MIT.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\licenses\ai\BSD-3-Clause.txt">
      <Link>licenses\ai\BSD-3-Clause.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\licenses\ai\PSF-2.0.txt">
      <Link>licenses\ai\PSF-2.0.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\licenses\ai\NOTICE.txt">
      <Link>licenses\ai\NOTICE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 窗口图标运行时从 ICO.ico 加载（Form1.Designer.vb），随 exe 部署。 -->
  <ItemGroup>
    <None Include="ICO.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProductNative Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" />
    <!-- Side-lane helper is optional: when it has not been built the kernel
         degrades to the in-process lane, so an empty item must not break build. -->
    <PrefetchHelper Include="..\build\FFF.PrefetchHost.exe"
                    Condition="Exists('..\build\FFF.PrefetchHost.exe')" />
    <DevelopmentRuntime Include="..\runtime\avcodec*.dll" />
    <DevelopmentRuntime Include="..\runtime\avformat*.dll" />
    <DevelopmentRuntime Include="..\runtime\avutil*.dll" />
    <DevelopmentRuntime Include="..\runtime\swresample*.dll" />
    <DevelopmentRuntime Include="..\runtime\swscale*.dll" />
    <DevelopmentRuntime Include="..\runtime\avfilter*.dll" />
    <LibassMainRuntime Include="$(LibassRuntimeDirectory)\ass-*.dll" />
    <LibassRuntime Include="@(LibassMainRuntime);$(LibassRuntimeDirectory)\brotlicommon.dll;$(LibassRuntimeDirectory)\brotlidec.dll;$(LibassRuntimeDirectory)\fribidi-0.dll;$(LibassRuntimeDirectory)\harfbuzz.dll" />
    <LibassRuntime Include="$(LibassRuntimeDirectory)\bz2d.dll;$(LibassRuntimeDirectory)\freetyped.dll;$(LibassRuntimeDirectory)\libpng16d.dll;$(LibassRuntimeDirectory)\zd.dll" Condition="'$(Configuration)' == 'Debug'" />
    <LibassRuntime Include="$(LibassRuntimeDirectory)\bz2.dll;$(LibassRuntimeDirectory)\freetype.dll;$(LibassRuntimeDirectory)\libpng16.dll;$(LibassRuntimeDirectory)\z.dll" Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <!-- O4（2026-10-30）：图标改为烘焙 PNG 后，运行时代码不再直接使用 Svg（及传递依赖 ExCSS）。
       现无改色/换肤通路（11 个 SVG 描边写死 #dcdcdc，无 currentColor/CSS 变量）；改图标时重跑 bake_icons.ps1。
       【2026-11-01 修复】曾移除本 PackageReference 以减包体，但在含 upstream PR #49 的合并构建
       （PublishReadyToRun）下触发启动 ~417ms CLR FailFast（0xC0000602，三无：stderr/事件日志/WER 全空）；
       恢复引用后消融验证双向成立（移除=崩、恢复=活、事后拷 DLL 不救，属构建期差异而非运行时缺文件）。
       故保留该引用（代价仅输出目录被动文件 ~0.6MB，启动路径不加载），烘焙收益全部保留。 -->
  <PackageReference Include="Svg" Version="3.4.8" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- O4（2026-10-30）：按钮图标改为构建期烘焙的 PNG（设计源 svg 仍留在仓内，不进包）。
         依据 imgperf/o3o4_analysis.md §2.4：11/11 像素级一致，运行时不再需要 Svg/ExCSS/Xml 首触。 -->
    <None Include="Resources\播放器按钮\*.svg" />
    <EmbeddedResource Include="Resources\播放器按钮\播放.png" LogicalName="FFF.Player.Resources.PlayerButtons.Play.png" />
    <EmbeddedResource Include="Resources\播放器按钮\暂停.png" LogicalName="FFF.Player.Resources.PlayerButtons.Pause.png" />
    <EmbeddedResource Include="Resources\播放器按钮\停止.png" LogicalName="FFF.Player.Resources.PlayerButtons.Stop.png" />
    <EmbeddedResource Include="Resources\播放器按钮\倒退或上一个.png" LogicalName="FFF.Player.Resources.PlayerButtons.Previous.png" />
    <EmbeddedResource Include="Resources\播放器按钮\前进或下一个.png" LogicalName="FFF.Player.Resources.PlayerButtons.Next.png" />
    <EmbeddedResource Include="Resources\播放器按钮\打开.png" LogicalName="FFF.Player.Resources.PlayerButtons.Open.png" />
    <EmbeddedResource Include="Resources\播放器按钮\设置.png" LogicalName="FFF.Player.Resources.PlayerButtons.Settings.png" />
    <EmbeddedResource Include="Resources\播放器按钮\播放列表.png" LogicalName="FFF.Player.Resources.PlayerButtons.Playlist.png" />
    <EmbeddedResource Include="Resources\播放器按钮\剪辑区间.png" LogicalName="FFF.Player.Resources.PlayerButtons.ClipRange.png" />
    <EmbeddedResource Include="Resources\播放器按钮\元数据.png" LogicalName="FFF.Player.Resources.PlayerButtons.Metadata.png" />
    <EmbeddedResource Include="Resources\播放器按钮\流选择.png" LogicalName="FFF.Player.Resources.PlayerButtons.Streams.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFF.Native\FFF.Native.vcxproj" Condition="'$(MSBuildRuntimeType)' != 'Core'" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true">

      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <Content Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" Link="FFF.Native.dll">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
    <Content Include="@(LibassRuntime)" Link="%(Filename)%(Extension)">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>


  <Target Name="VerifyPlayerApiVersion" BeforeTargets="Build;Publish">
    <PropertyGroup>
      <_PlayerApiCpp>$(MSBuildThisFileDirectory)..\FFF.Native\3FP\Api\PlayerApi.cpp</_PlayerApiCpp>
      <_PlayerSessionVb>$(MSBuildThisFileDirectory)Core\播放器会话.vb</_PlayerSessionVb>
    </PropertyGroup>

    <Error Condition="!Exists('$(_PlayerApiCpp)')"
           Text="版本校验找不到内核源文件：$(_PlayerApiCpp)" />
    <Error Condition="!Exists('$(_PlayerSessionVb)')"
           Text="版本校验找不到宿主源文件：$(_PlayerSessionVb)" />


    <PropertyGroup>
      <_KernelApiVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerApiCpp)')),
        'PlayerApiVersion\s*=\s*(\d+)').Groups[1].Value)</_KernelApiVersion>
    </PropertyGroup>

    <PropertyGroup>
      <_HostSentVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerSessionVb)')),
        '原生播放器配置大小,\s*\.版本\s*=\s*(\w+)').Groups[1].Value)</_HostSentVersion>
    </PropertyGroup>

    <PropertyGroup>
      <_HostCheckedVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerSessionVb)')),
        '期望API版本\s+As\s+UInteger\s*=\s*(\d+)UI').Groups[1].Value)</_HostCheckedVersion>
    </PropertyGroup>

    <Error Condition="'$(_KernelApiVersion)' == ''"
           Text="无法从 PlayerApi.cpp 解析 PlayerApiVersion。校验无法进行。" />
    <Error Condition="'$(_HostSentVersion)' == ''"
           Text="无法从 播放器会话.vb 解析配置写入的版本（'原生播放器配置大小, .版本 = ...'）。校验无法进行。" />
    <Error Condition="'$(_HostCheckedVersion)' == ''"
           Text="无法从 播放器会话.vb 解析 '期望API版本 As UInteger = NNUI'。校验无法进行。" />

    <Message Importance="high"
             Text="3FP API 版本：内核=$(_KernelApiVersion) 宿主发送=$(_HostSentVersion) 宿主校验=$(_HostCheckedVersion) 工程声明=$(PlayerApiVersion)" />

    <Error Condition="'$(_KernelApiVersion)' != '$(PlayerApiVersion)'"
           Text="发布中止：内核 API 版本 ($(_KernelApiVersion)) 与本工程声明 ($(PlayerApiVersion)) 不一致。请同步 FFF.Player.vbproj 的 &lt;PlayerApiVersion&gt;，并重新构建 FFF.Native。" />
    <Error Condition="'$(_HostCheckedVersion)' != '$(PlayerApiVersion)'"
           Text="发布中止：宿主常量 期望API版本 ($(_HostCheckedVersion)) 与本工程声明 ($(PlayerApiVersion)) 不一致。请同步 播放器会话.vb 的 'Friend Const 期望API版本 As UInteger = NNUI'。" />

    <Error Condition="'$(_HostSentVersion)' != '期望API版本'"
           Text="发布中止：配置里的版本写法为 '$(_HostSentVersion)'，应为常量 '期望API版本'。字面量会让版本号出现第四份副本。" />


    <PropertyGroup>
      <_NativeResourceRc>$(MSBuildThisFileDirectory)..\FFF.Native\FFF.Native.rc</_NativeResourceRc>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NativeResourceRc)')"
           Text="版本校验找不到原生版本资源：$(_NativeResourceRc)" />
    <PropertyGroup>
      <_RcVerApi>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '\#define\s+VER_API\s+(\d+)').Groups[1].Value)</_RcVerApi>
      <_RcFileVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '"FileVersion",\s*"(\d+)').Groups[1].Value)</_RcFileVersion>
      <_RcApiVersion>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '"ApiVersion",\s*"(\d+)').Groups[1].Value)</_RcApiVersion>
      <_RcProductApi>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_NativeResourceRc)')),
        '\(api (\d+)\)').Groups[1].Value)</_RcProductApi>
    </PropertyGroup>

    <Error Condition="'$(_RcVerApi)' == '' Or '$(_RcFileVersion)' == '' Or
                     '$(_RcApiVersion)' == '' Or '$(_RcProductApi)' == ''"
           Text="无法从 FFF.Native.rc 解析版本号（应同时找到 VER_API、FileVersion、ApiVersion 与 &quot;(api NN)&quot;）。版本校验无法进行。" />
    <Message Importance="high"
             Text="3FP API 版本（第四份：原生版本资源）：VER_API=$(_RcVerApi) FileVersion=$(_RcFileVersion) ApiVersion=$(_RcApiVersion) ProductVersion 内 api=$(_RcProductApi)" />
    <Error Condition="'$(_RcVerApi)' != '$(PlayerApiVersion)'"
           Text="发布中止：FFF.Native.rc 的 VER_API ($(_RcVerApi)) 与 API 版本 ($(PlayerApiVersion)) 不一致。改 rc 主版本号后必须重新构建 FFF.Native。" />
    <Error Condition="'$(_RcFileVersion)' != '$(PlayerApiVersion)'"
           Text="发布中止：FFF.Native.rc 的 FileVersion 字符串 ($(_RcFileVersion)) 与 API 版本 ($(PlayerApiVersion)) 不一致 —— 部署现场读的就是这一段。" />
    <Error Condition="'$(_RcApiVersion)' != '$(PlayerApiVersion)'"
           Text="发布中止：FFF.Native.rc 的 ApiVersion 字符串 ($(_RcApiVersion)) 与 API 版本 ($(PlayerApiVersion)) 不一致。" />
    <Error Condition="'$(_RcProductApi)' != '$(PlayerApiVersion)'"
           Text="发布中止：FFF.Native.rc 的 ProductVersion &quot;(api NN)&quot; ($(_RcProductApi)) 与 API 版本 ($(PlayerApiVersion)) 不一致。" />
  </Target>


  <Target Name="VerifyPlayerConfigSize" BeforeTargets="Publish"
          DependsOnTargets="VerifyPlayerApiVersion">
    <PropertyGroup>
      <_PlayerApiHeader>$(MSBuildThisFileDirectory)..\FFF.Native\3FP\Api\FFF.Player.Api.h</_PlayerApiHeader>
      <_HostInteropVb>$(MSBuildThisFileDirectory)Interop\播放器原生接口.vb</_HostInteropVb>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PlayerApiHeader)')"
           Text="结构体校验找不到内核头文件：$(_PlayerApiHeader)" />
    <Error Condition="!Exists('$(_HostInteropVb)')"
           Text="结构体校验找不到宿主互操作文件：$(_HostInteropVb)" />


    <PropertyGroup>
      <_KernelConfigBody>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_PlayerApiHeader)')),
        '(?s)struct FFF3FPConfiguration\s*\{(.*?)\n\s*\};').Groups[1].Value)</_KernelConfigBody>
      <_KernelConfigFields>$([System.Text.RegularExpressions.Regex]::Matches(
        '$(_KernelConfigBody)', '(?m)^\s+(?!//)\S[^;]*;').Count)</_KernelConfigFields>
    </PropertyGroup>

    <PropertyGroup>
      <_HostConfigBody>$([System.Text.RegularExpressions.Regex]::Match(
        $([System.IO.File]::ReadAllText('$(_HostInteropVb)')),
        '(?s)Structure 原生播放器配置(.*?)End Structure').Groups[1].Value)</_HostConfigBody>
      <_HostConfigFields>$([System.Text.RegularExpressions.Regex]::Matches(
        '$(_HostConfigBody)', '(?m)^\s+Public \w+ As ').Count)</_HostConfigFields>
    </PropertyGroup>

    <Error Condition="'$(_KernelConfigFields)' == '' Or '$(_KernelConfigFields)' == '0'"
           Text="无法解析 FFF3FPConfiguration 的字段。结构体校验无法进行。" />
    <Error Condition="'$(_HostConfigFields)' == '' Or '$(_HostConfigFields)' == '0'"
           Text="无法解析 原生播放器配置 的字段。结构体校验无法进行。" />

    <Message Importance="high"
             Text="3FP 配置结构体字段数：内核=$(_KernelConfigFields) 宿主=$(_HostConfigFields)" />

    <Error Condition="'$(_KernelConfigFields)' != '$(_HostConfigFields)'"
           Text="发布中止：配置结构体字段数不一致（内核 $(_KernelConfigFields) vs 宿主 $(_HostConfigFields)）。宿主会因 size 不足被 FFF3FP_Create 拒绝。请在 原生播放器接口.vb 的 原生播放器配置 末尾补齐缺失字段。" />
  </Target>

  <Target Name="CopyNativeRuntime" AfterTargets="Build">
    <Error Condition="!Exists('..\FFF.Native\x64\$(Configuration)\FFF.Native.dll')" Text="请先构建 FFF.Native 的 x64 $(Configuration) 配置。" />
    <Error Condition="'@(LibassMainRuntime)' == ''" Text="缺少 libass 运行库；请先运行 tools\准备Libass.ps1。" />
    <Copy SourceFiles="@(ProductNative);@(DevelopmentRuntime);@(LibassRuntime);@(PrefetchHelper)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>


  <Target Name="CopyProductNativeToPublish" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
    <Error Condition="'@(DevelopmentRuntime)' == '' and '$(BodyOnly)' != 'true'"
           Text="找不到 FFmpeg 运行库（..\runtime\av*.dll 等）。请确认 kernel\runtime 已就位，或使用 BodyOnly=true 生成本体包。" />
    <ItemGroup>
      <!-- BodyOnly=true 时只复制本体与 libass 栈，不把外部 FFmpeg runtime 带进 publish。 -->
      <_ProductPublishFiles Include="@(ProductNative);@(LibassRuntime);@(PrefetchHelper)" />
      <_ProductPublishFiles Include="@(DevelopmentRuntime)" Condition="'$(BodyOnly)' != 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProductPublishFiles)"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>


  <Target Name="RejectPrivateColorExtensionPublish" AfterTargets="ComputeFilesToPublish" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <PrivateColorExtension Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'FFF.DolbyVision.Test.dll'" />
    </ItemGroup>
    <Error Condition="'@(PrivateColorExtension)' != ''" Text="侵权护栏：旧商标私有 DLL FFF.DolbyVision.Test.dll 不得发布或打包；中性模块请使用 FFF.HDRdp.Test.dll。" />
  </Target>

  <!-- WinRT 投影配对护栏（2026-10-29）：
       曾尝试从交付剔除 Microsoft.Windows.SDK.NET.dll（~27.2 MB，应用零 WinRT 使用），
       但引用闭包实测证伪：Vortice.Mathematics.dll 引用 Microsoft.Windows.SDK.NET（且被
       Vortice.DXGI/Direct3D11 广泛使用），Vortice.DirectX.dll 引用 WinRT.Runtime——两件
       均不可剔（分析全程见 docs/105 §五/§六/§八）。
       本护栏不再做剔除，而是锁住“引用⇒随包”配对：任何随包托管件引用了这两个投影件，
       交付里就必须有它们；将来若有人重新尝试剔除（或 SDK 行为变化导致漏拷），构建当场报错。 -->
  <UsingTask TaskName="AssertWindowsSdkProjectionPairing" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ScanDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var selfNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "Microsoft.Windows.SDK.NET.dll", "WinRT.Runtime.dll" };
        bool needSdk = false, needRt = false, hasSdk = false, hasRt = false;
        foreach (var file in Directory.GetFiles(ScanDirectory, "*.dll"))
        {
            var fileName = Path.GetFileName(file);
            if (fileName.Equals("Microsoft.Windows.SDK.NET.dll", StringComparison.OrdinalIgnoreCase)) { hasSdk = true; continue; }
            if (fileName.Equals("WinRT.Runtime.dll", StringComparison.OrdinalIgnoreCase)) { hasRt = true; continue; }
            var text = Encoding.GetEncoding(28591).GetString(File.ReadAllBytes(file));
            if (text.Contains("Microsoft.Windows.SDK.NET")) needSdk = true;
            if (text.Contains("WinRT.Runtime")) needRt = true;
        }
        if (needSdk && !hasSdk)
            Log.LogError("WinRT 投影配对护栏：随包托管件引用了 Microsoft.Windows.SDK.NET，但交付缺少该文件——剔除/漏拷会静默破坏运行时，请恢复或先解除引用闭包。", Array.Empty<object>());
        if (needRt && !hasRt)
            Log.LogError("WinRT 投影配对护栏：随包托管件引用了 WinRT.Runtime，但交付缺少该文件——剔除/漏拷会静默破坏运行时，请恢复或先解除引用闭包。", Array.Empty<object>());
        ]]>
      </Code>
    </Task>
  </UsingTask>
  <Target Name="AssertWindowsSdkProjectionPairing" AfterTargets="Build">
    <AssertWindowsSdkProjectionPairing ScanDirectory="$(OutDir)" />
  </Target>

  <ItemGroup>
    <Reference Include="LakeUI">
      <HintPath>..\..\LakeUI\LakeUI\bin\$(LakeUIConfig)\$(LakeUITfm)\LakeUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UI\播放器画面控件.vb" />
    <EmbeddedResource Remove="F:\Git\3F_Project\tools\..\third_party\vcpkg_installed\x64-windows\share\libbluray\copyright" />
    <EmbeddedResource Remove="F:\Git\3F_Project\tools\..\third_party\vcpkg_installed\x64-windows\share\libiconv\copyright" />
    <EmbeddedResource Remove="F:\Git\3F_Project\tools\..\third_party\vcpkg_installed\x64-windows\share\libudfread\copyright" />
    <EmbeddedResource Remove="F:\Git\3F_Project\tools\..\third_party\vcpkg_installed\x64-windows\share\libxml2\copyright" />
    <Compile Include="UI\播放器画面控件.vb">
      <SubType>Code</SubType>
    </Compile>
    <Content Include="ICO.ico" />
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>


  <!-- LakeUI 引用护栏：把「LakeUI 找不到」从数百条「未定义类型」错误变成一条明确报错。
       默认（宿主与 LakeUI 同为 .NET 10）不发任何消息，行为与改动前一致。 -->
  <Target Name="VerifyLakeUIReference" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
    <PropertyGroup>
      <_LakeUIRef>$(MSBuildThisFileDirectory)..\..\LakeUI\LakeUI\bin\$(LakeUIConfig)\$(LakeUITfm)\LakeUI.dll</_LakeUIRef>
      <!-- 大版本号（net10.0-... -> 10.0），仅用于混血检测。先判长度再取子串：
           短串（如 net8.0）会让 Substring 自己抛越界，取代本要给出的明确报错。 -->
      <_NetTfmMajor Condition="$(NetTFM.Length) &gt;= 7">$(NetTFM.Substring(3, 4))</_NetTfmMajor>
      <_LakeUiTfmMajor Condition="$(LakeUITfm.Length) &gt;= 7">$(LakeUITfm.Substring(3, 4))</_LakeUiTfmMajor>
    </PropertyGroup>
    <Error Condition="'$(_NetTfmMajor)' == '' Or '$(_LakeUiTfmMajor)' == ''"
           Text="无法从 TFM 解析大版本号（NetTFM='$(NetTFM)'，LakeUITfm='$(LakeUITfm)'）。期望形如 net10.0-windows10.0.26100.0；混血检测靠它，解析不了就不能放行。" />
    <Error Condition="!Exists('$(_LakeUIRef)')"
           Text="LakeUI 引用缺失，未找到：$(_LakeUIRef)（当前 LakeUIConfig=$(LakeUIConfig)，LakeUITfm=$(LakeUITfm)）。请先在兄弟仓 LakeUI 用该配置与目标框架产出产物：Release 档必须是 R2R 件（dotnet publish -c Release -r win-x64 --self-contained false -p:PublishReadyToRun=true，纯 build 产物不含本机码不算 R2R），Debug 档用 dotnet build -c Debug 即可；也可对本工程传 -p:LakeUIConfig=Debug 回退，或 -p:LakeUITfm=某已有目标框架 指向既有产物。" />
    <Warning Condition="'$(_NetTfmMajor)' != '$(_LakeUiTfmMajor)'"
             Text="宿主 TFM ($(NetTFM)) 与 LakeUI TFM ($(LakeUITfm)) 大版本不一致 —— 当前是「宿主 .NET $(_NetTfmMajor) + UI 库 .NET $(_LakeUiTfmMajor)」的混血状态。运行时可工作（程序集引用向下兼容），但 LakeUI 上游一旦重建别的 TFM，本 HintPath 会静默失效。建议推进 LakeUI 同步升级到与宿主一致的目标框架。" />
  </Target>

</Project>
