root = true

# 3FP 的 .NET 11 分析器基线。
#
# 本文件**只做点名抑制，不做全局降噪**。net11 的 Windows Forms 分析器从 1 条规则
# （WFO0003）涨到 15 条（WFO0003 + WFO2000 + WFO3000–3012），其中 WFO3xxx 是 Error 级。
# 每加一条抑制都必须写明「理由」和「什么条件下该删掉它」，否则后人撞上同类新代码时会被静音。
#
# 规则位置备忘（不在 SDK 里，容易被找错）：
#   packs/Microsoft.WindowsDesktop.App.Ref/<ver>/analyzers/dotnet/System.Windows.Forms.Analyzers.dll
#   net10.0.13        = 33,064 B，1 条规则
#   net11 rc.2        = 49,960 B，15 条规则
# ⇒ 若某次 net11 构建"0 警告"，先确认加载的是 15 条那一份（标志：WFO2000 是否可能出现），
#   否则是假绿。

###############################################################################
# WFO2000 —— 属性 getter 内构造新的引用实例
#
# 规则本意：getter 每次都新建对象，既每次分配，也暗示调用方拿到的是"会变的实例"。
# 修法有三种：提为共享字段 / 改用工厂方法 / 把 getter 换成方法。
#
# 本仓唯一的例外是 播放器会话.当前快照：它的语义就是"每次读播放器当下状态"
# （内部直接走 FFF3FP_GetSnapshot），缓存会让它返回**过期**数据 —— 那才是真 bug。
# 该属性有 118 处调用方，全部是"读字段"用法，无一依赖引用相等性，
# 换成方法或缓存都只会在满足分析器的同时破坏语义。
#
# 因此这里按**文件作用域**抑制而非全局抑制：将来别处再命中 WFO2000，
# 仍应按规则本意处理（本项目里 ColorTransformInjectionRegression.顺序 就是这样改掉的）。
###############################################################################
[FFF.Player/Core/播放器会话.vb]
dotnet_diagnostic.WFO2000.severity = none
