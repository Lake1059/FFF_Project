Option Strict On
Option Explicit On

''' <summary>
''' Ai字幕状态机的纯逻辑用例。每个用例都是"提交若干条结果 + 在某个播放位置问
''' 该显示什么"，不涉及任何播放器状态。
'''
''' 重点覆盖两处曾经出过真实故障的语义：
'''   1) 代次/陈旧/未来三条守卫 —— 决定 seek、暂停、切文件后屏上是否残留旧字幕；
'''   2) worker 退出标志的置位与复位 —— 这个标志只置位不复位过一次，导致"停止一次
'''      或换一次后端之后字幕永久空白"，而当时的端到端测试是"打开一个文件播到底"，
'''      恰好一次都不经过停止路径，所以全绿。
''' </summary>
Module Program

    Private 通过 As Integer
    Private 失败 As Integer

    Function Main() As Integer
        Console.OutputEncoding = Text.Encoding.UTF8

        基本显示()
        代次跳变立即清空()
        未来守卫挡跨时间线条目()
        陈旧守卫不让死字幕僵在屏上()
        暂停不误杀()
        worker退出后清空()
        ' —— 以下三条是 P0 回归：停止/换后端必须先复位标志 ——
        重置后能重新显示()
        复位Worker退出后能重新显示()
        重置清掉在途结果()
        空文本不显示()
        轻微超前仍在余量内()
        ' —— 驻留偏移（L0-5）：正负双向 + 未来守卫同向收紧 ——
        驻留偏移正负双向()
        驻留偏移也作用于未来守卫()
        ' —— 字幕语言：语言表自检 + 闸门判定（静默类失效，只能靠纯逻辑兜住）——
        语言表自检()
        语言规整()
        语言传参值()
        语言闸门()
        语言混说闸门()
        语言已指定()

        Console.WriteLine()
        Console.WriteLine($"通过 {通过} / 失败 {失败}")
        Return 失败
    End Function

    ' ---------------- 用例 ----------------

    Sub 基本显示()
        Dim 机 As New Ai字幕状态机
        机.提交结果(条目(0, 1.0, 5.0, "你好世界"))
        断言(取(机, 2.0, 0) = "你好世界", "基本显示：同代次、位置落在条目内 → 显示")
    End Sub

    Sub 代次跳变立即清空()
        Dim 机 As New Ai字幕状态机
        机.提交结果(条目(0, 1.0, 5.0, "seek 之前的话"))
        断言(取(机, 2.0, 0) = "seek 之前的话", "代次跳变：先确认基线可见")
        ' seek 后内核代次变成 1，条目还是 0 → 必须立刻清空，不等 worker 确认。
        断言(取(机, 2.0, 1) = "", "代次跳变：代次不匹配 → 立即清空")
        断言(取(机, 2.0, 1) = "", "代次跳变：清空后再问仍为空（没有复活）")
        机.提交结果(条目(1, 1.0, 5.0, "seek 之后的话"))
        断言(取(机, 2.0, 1) = "seek 之后的话", "代次跳变：新代次条目到达 → 恢复显示")
    End Sub

    Sub 未来守卫挡跨时间线条目()
        Dim 机 As New Ai字幕状态机
        ' 切文件后 worker 在途的旧结果：起始比播放位置超前 98s，远超 3×窗口=15s。
        机.提交结果(条目(0, 100.0, 105.0, "别的文件的字幕"))
        断言(取(机, 2.0, 0) = "", "未来守卫：起始超前 98s → 隐藏")
    End Sub

    Sub 陈旧守卫不让死字幕僵在屏上()
        Dim 机 As New Ai字幕状态机
        机.提交结果(条目(0, 1.0, 5.0, "推理卡住时的旧字幕"))
        ' 结束 5s + 余量 10s = 15s < 30s → 必须隐藏（用户红线：不能有鬼影字幕）。
        断言(取(机, 30.0, 0) = "", "陈旧守卫：结束+2×窗口仍早于播放位置 → 隐藏")
    End Sub

    Sub 暂停不误杀()
        Dim 机 As New Ai字幕状态机
        机.提交结果(条目(0, 1.0, 5.0, "暂停时保持可见"))
        ' 暂停 5 分钟：播放位置不动，条目不该过期（不是按墙钟算的）。
        断言(取(机, 5.0, 0) = "暂停时保持可见", "暂停：播放位置不动 → 字幕保持")
    End Sub

    Sub worker退出后清空()
        Dim 机 As New Ai字幕状态机
        机.提交结果(条目(0, 1.0, 5.0, "worker 死了之后的话"))
        机.通知Worker已退出()
        断言(取(机, 2.0, 0) = "", "worker 退出：当前条目立即清空（不等陈旧守卫）")
        ' 在途的旧结果也不该再被采纳。
        机.提交结果(条目(0, 1.0, 5.0, "退出后才到的结果"))
        断言(取(机, 2.0, 0) = "", "worker 退出：退出后到达的结果被丢弃")
    End Sub

    Sub 重置后能重新显示()
        Dim 机 As New Ai字幕状态机
        机.提交结果(条目(0, 1.0, 5.0, "第一次"))
        机.通知Worker已退出()
        ' 这就是 控制器.停止() 的真实顺序：管道.停止() 会通知退出，紧接着 状态机.重置()。
        机.重置()
        机.提交结果(条目(0, 1.0, 5.0, "停止后重新开始"))
        断言(取(机, 2.0, 0) = "停止后重新开始",
             "P0 回归：通知退出 + 重置 → 新结果仍能显示（旧实现从此永久空白）")
    End Sub

    Sub 复位Worker退出后能重新显示()
        Dim 机 As New Ai字幕状态机
        机.提交结果(条目(0, 1.0, 5.0, "第一次"))
        机.通知Worker已退出()
        机.复位Worker退出()
        机.提交结果(条目(0, 1.0, 5.0, "复位后重新开始"))
        断言(取(机, 2.0, 0) = "复位后重新开始",
             "P0 回归：复位Worker退出 → 新结果仍能显示（换后端重启走这条）")
    End Sub

    Sub 重置清掉在途结果()
        Dim 机 As New Ai字幕状态机
        机.提交结果(条目(0, 1.0, 5.0, "还没被消费的旧结果"))
        机.重置()
        断言(取(机, 2.0, 0) = "", "重置：队列里的在途结果一并丢弃")
    End Sub

    Sub 空文本不显示()
        Dim 机 As New Ai字幕状态机
        机.提交结果(条目(0, 1.0, 5.0, ""))
        断言(取(机, 2.0, 0) = "", "空文本：纯静音/噪声窗不给空字幕（否则会顶掉上一句）")
        机.提交结果(条目(0, 1.0, 5.0, "   "))
        断言(取(机, 2.0, 0) = "", "空文本：纯空白同样不显示")
    End Sub

    Sub 轻微超前仍在余量内()
        Dim 机 As New Ai字幕状态机
        ' 推理滞后下条目起始只会略早于播放位置；但轻微超出（<3×窗口）不该被未来守卫误杀。
        机.提交结果(条目(0, 2.0, 6.0, "略超前"))
        断言(取(机, 1.0, 0) = "略超前", "未来守卫：超前 1s（远小于余量）→ 正常显示")
    End Sub

    ' ---------------- 驻留偏移（时间偏移100纳秒，L0-5 契约） ----------------
    '
    ' 它同时作用于两条守卫的判定位置（= 播放位置 − 偏移），且是"UI 看着能改、
    ' 实际不生效"类静默故障的高发形态——设置页滑块只改设置值，同步链断了不会
    ' 报任何错，只能靠纯逻辑用例兜住（SMOKE 第 28 项只能目视）。

    Sub 驻留偏移正负双向()
        ' 基线：偏移 0 时条目 [1,5] 在 20s 处已被陈旧守卫收起（5+10 < 20）。
        Dim 基线 As New Ai字幕状态机
        基线.提交结果(条目(0, 1.0, 5.0, "旧字幕"))
        断言(取(基线, 20.0, 0) = "", "驻留偏移：偏移 0 时 20s 处已收起（基线）")

        ' 正偏移 +10s：判定位置 = 20−10 = 10，5+10=15 ≥ 10 → 多驻留 10s。
        Dim 多留 As New Ai字幕状态机
        多留.时间偏移100纳秒 = CLng(10.0 * 10000000.0)
        多留.提交结果(条目(0, 1.0, 5.0, "旧字幕"))
        断言(取(多留, 20.0, 0) = "旧字幕", "驻留偏移：+10s 在 20s 处仍显示（判定位置回到余量内）")
        ' 但不是永久：判定位置 26−10=16 > 15 → 仍要收起。
        断言(取(多留, 26.0, 0) = "", "驻留偏移：+10s 只多留 10s，26s 处照常收起")

        ' 负偏移 −10s：判定位置 = 6+10 = 16 > 15 → 提前收起（原应显示到 15s）。
        Dim 提前 As New Ai字幕状态机
        提前.时间偏移100纳秒 = CLng(-10.0 * 10000000.0)
        提前.提交结果(条目(0, 1.0, 5.0, "旧字幕"))
        断言(取(提前, 6.0, 0) = "", "驻留偏移：−10s 在 6s 处提前收起")
    End Sub

    Sub 驻留偏移也作用于未来守卫()
        ' 条目起始 30s，播放位置 20s：偏移 0 时超前 10s < 余量 15s → 显示。
        Dim 基线 As New Ai字幕状态机
        基线.提交结果(条目(0, 30.0, 35.0, "下一句"))
        断言(取(基线, 20.0, 0) = "下一句", "驻留偏移：偏移 0 时超前 10s 在余量内（基线）")
        ' 正偏移 +20s：判定位置 = 20−20 = 0，超前 30s > 15s → 被未来守卫收起。
        ' 慢读者把偏移拉大后，"属于下一条时间线"的判定也要跟着收紧，否则旧
        ' 条目会在错位的位置上复活。
        Dim 收紧 As New Ai字幕状态机
        收紧.时间偏移100纳秒 = CLng(20.0 * 10000000.0)
        收紧.提交结果(条目(0, 30.0, 35.0, "下一句"))
        断言(取(收紧, 20.0, 0) = "", "驻留偏移：+20s 让未来守卫同向收紧（超前按判定位置算）")
    End Sub

    ' ---------------- 字幕语言 ----------------
    '
    ' 这几条防的都是"静默"类故障：不会抛、不会崩，只是字幕没了或者语言提示白设。
    ' 语言表自检同时兼作 L0-1 —— 表在家用机器上被改错（漏映射、显示名重复）时，
    ' 唯一的现象就是下拉里多一个叫"自动"的重复项，或者选了没效果。
    '
    ' 2026-10-23 起界面只列主项 4 项（用户裁定"未验证的内容不出现"）：规整只认主项，
    ' 未验证语种的 id（ja/yue/…）无论从哪来（老设置、手改 json）都归 auto。整表
    ' 全部 32 项保留仅为 check_l0 与 worker LANGUAGE_NAMES 的防漂移对比。

    Sub 语言表自检()
        断言(Ai字幕语言.全部.Length = 32, "语言表：整表 32 项（防漂移对比用，界面只列主项）")
        断言(Ai字幕语言.主项.Length = 4 AndAlso Ai字幕语言.全部(3) = Ai字幕语言.混说,
            "语言表：前四项是主项（自动/中文/English/混说）")
        断言(Ai字幕语言.全部(0) = Ai字幕语言.自动, "语言表：第 0 项必须是 auto（下拉默认项）")
        ' 界面顺序 = 主项顺序，且主项必须是整表的前 4 项（改表时最容易破坏的不变量）。
        For i = 0 To Ai字幕语言.主项.Length - 1
            断言(Ai字幕语言.全部(i) = Ai字幕语言.主项(i),
                $"语言表：主项({i}) 与整表前四项对齐（界面顺序依赖它）")
        Next

        Dim 缺名 As New List(Of String)
        Dim 见过的名 As New HashSet(Of String)(StringComparer.Ordinal)
        Dim 重复 As New List(Of String)
        Dim 自动显示名 = Ai字幕语言.显示名(Ai字幕语言.自动)
        ' 只查主项：未验证语种不上面板，也就没有显示名可查（它们的显示名就是 auto 的）。
        For Each id In Ai字幕语言.主项
            If id = Ai字幕语言.自动 Then Continue For
            ' 中英混说故意没有英文名（它不传 language 提示，靠闸门放行两种标签）。
            If id <> Ai字幕语言.混说 AndAlso Ai字幕语言.规范名(id).Length = 0 Then 缺名.Add(id)
            Dim 名 = Ai字幕语言.显示名(id)
            If 名.Length = 0 OrElse 名 = 自动显示名 Then 缺名.Add(id)
            If Not 见过的名.Add(名) Then 重复.Add(名)
        Next
        断言(缺名.Count = 0, "语言表：每个主项都有英文名与显示名" &
            If(缺名.Count = 0, "", "（缺：" & String.Join(",", 缺名) & "）"))
        断言(重复.Count = 0, "语言表：主项显示名互不重复" &
            If(重复.Count = 0, "", "（重复：" & String.Join(",", 重复) & "）"))

        ' 未验证语种在界面上必须"不存在"：它们的显示名塌缩成 auto 的显示名，
        ' 且规整一律归 auto（老设置残留不许带着行为走）。
        断言(Ai字幕语言.显示名("ja") = 自动显示名, "未验证语种不上面板：显示名塌缩为自动")
        断言(Ai字幕语言.规整("ja") = Ai字幕语言.自动, "未验证语种：ja → auto（残留不许透传）")
        断言(Ai字幕语言.规整("yue") = Ai字幕语言.自动, "未验证语种：yue → auto")
        断言(Ai字幕语言.规整("mk") = Ai字幕语言.自动, "未验证语种：mk → auto")
        断言(Ai字幕语言.已指定("ja") = False, "未验证语种：不算已指定（闸门因此不启用）")
        断言(Ai字幕语言.传参值("ja") = "auto", "未验证语种：不把提示传给模型")
    End Sub

    Sub 语言规整()
        断言(Ai字幕语言.规整(Nothing) = Ai字幕语言.自动, "规整：Nothing → auto")
        断言(Ai字幕语言.规整("") = Ai字幕语言.自动, "规整：空串 → auto（老设置文件的常态）")
        断言(Ai字幕语言.规整("  ") = Ai字幕语言.自动, "规整：纯空白 → auto")
        断言(Ai字幕语言.规整(" zh ") = "zh", "规整：两侧空白被去掉")
        断言(Ai字幕语言.规整("ZH") = "zh", "规整：大小写不敏感")
        断言(Ai字幕语言.规整("klingon") = Ai字幕语言.自动, "规整：未知 id → auto（脏值不许透传）")
        断言(Ai字幕语言.规整("Chinese") = Ai字幕语言.自动, "规整：英文名不当作 id（只认 ISO 标识）")
    End Sub

    Sub 语言传参值()
        断言(Ai字幕语言.传参值("zh") = "Chinese", "传参：zh → Chinese（实测 ISO 代码模型不认）")
        断言(Ai字幕语言.传参值(Ai字幕语言.自动) = "auto", "传参：auto → auto")
        断言(Ai字幕语言.传参值("") = "auto", "传参：空值 → auto（worker 因此不带 language 字段）")
        断言(Ai字幕语言.传参值("klingon") = "auto", "传参：未知值绝不透传给模型")
        断言(Ai字幕语言.传参值("zh-CN") = "auto", "传参：zh-CN 不是我们的 id → auto")
        断言(Ai字幕语言.传参值(Ai字幕语言.混说) = "auto", "传参：中英混说不传提示（让模型按窗自判）")
    End Sub

    Sub 语言闸门()
        ' 只有"不符 且 勾选"才丢。任一条判反，用户看到的就是整片空白。
        断言(Not Ai字幕语言.应丢弃("chinese", True, "zh", True), "闸门：相符 + 勾选 → 保留")
        断言(Not Ai字幕语言.应丢弃("chinese", True, "zh", False), "闸门：相符 + 未勾 → 保留")
        断言(Ai字幕语言.应丢弃("english", False, "zh", True), "闸门：不符 + 勾选 → 丢弃")
        断言(Not Ai字幕语言.应丢弃("english", False, "zh", False), "闸门：不符 + 未勾 → 保留（默认绝不能整片空白）")
        断言(Not Ai字幕语言.应丢弃("japanese", False, Ai字幕语言.自动, True), "闸门：语言=自动 → 永不丢")
    End Sub

    Sub 语言混说闸门()
        ' 中英混说是唯一不看 worker matched 的档：worker 只有一个 target 名，
        ' 这个档必须按"模型自报的标签"判，否则中英混说素材会被整窗丢掉。
        断言(Not Ai字幕语言.应丢弃("chinese", False, Ai字幕语言.混说, True), "混说：中文标签 → 保留")
        断言(Not Ai字幕语言.应丢弃("english", False, Ai字幕语言.混说, True), "混说：英文标签 → 保留")
        断言(Ai字幕语言.应丢弃("japanese", False, Ai字幕语言.混说, True), "混说：日语标签 → 丢弃")
        断言(Not Ai字幕语言.应丢弃("", False, Ai字幕语言.混说, True), "混说：标签缺失 → 保留（不乱杀）")
        断言(Not Ai字幕语言.应丢弃("japanese", False, Ai字幕语言.混说, False), "混说：未勾选 → 永不丢")
        断言(Ai字幕语言.允许集(Ai字幕语言.混说).Length = 2, "混说：放行中文与英文两种标签")
        断言(Ai字幕语言.允许集("zh").Length = 1 AndAlso Ai字幕语言.允许集("zh")(0) = "chinese",
             "允许集：单语言档只放行一个")
        断言(Ai字幕语言.允许集(Ai字幕语言.自动).Length = 0, "允许集：自动 → 不按语言筛")
    End Sub

    Sub 语言已指定()
        断言(Not Ai字幕语言.已指定(Ai字幕语言.自动), "已指定：auto → False（复选框应置灰）")
        断言(Not Ai字幕语言.已指定(""), "已指定：空值 → False")
        断言(Ai字幕语言.已指定("zh"), "已指定：zh → True")
    End Sub

    ' ---------------- 工具 ----------------

    Function 条目(代次 As ULong, 起始秒 As Double, 结束秒 As Double, 文本 As String) As Ai字幕状态机.Ai字幕条目
        Return New Ai字幕状态机.Ai字幕条目(
            代次, CLng(起始秒 * 10000000.0), CLng(结束秒 * 10000000.0), 文本, "chinese")
    End Function

    Function 取(机 As Ai字幕状态机, 播放秒 As Double, 时间轴代次 As ULong) As String
        Return 机.取当前条目(TimeSpan.FromSeconds(播放秒), 时间轴代次)
    End Function

    Sub 断言(条件 As Boolean, 名称 As String)
        If 条件 Then
            通过 += 1
            Console.WriteLine($"PASS  {名称}")
        Else
            失败 += 1
            Console.WriteLine($"FAIL  {名称}")
        End If
    End Sub

End Module
