<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\third_party\FFmpegRuntime.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NetTFM Condition="'$(NetTFM)' == ''">net11.0-windows10.0.26100.0</NetTFM>
    <TargetFramework>$(NetTFM)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace></RootNamespace>
    <StartupObject>Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFF.Recorder\FFF.Recorder.vbproj" />
    <ProductNative Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" />
  </ItemGroup>

  <Target Name="CopyNativeRuntime" AfterTargets="Build">
    <Error Condition="!Exists('..\FFF.Native\x64\$(Configuration)\FFF.Native.dll')" Text="请先构建 FFF.Native 的 x64 $(Configuration) 配置。" />
    <Copy SourceFiles="@(ProductNative);@(DevelopmentRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
