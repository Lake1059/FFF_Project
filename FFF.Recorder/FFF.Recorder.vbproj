<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\third_party\FFmpegRuntime.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <NetTFM Condition="'$(NetTFM)' == ''">net11.0-windows10.0.26100.0</NetTFM>
    <TargetFramework>$(NetTFM)</TargetFramework>
    <!-- Windows.Graphics.Capture and the notification library use managed WinRT projections. -->
    <IncludeWindowsSDKRefFrameworkReferences>true</IncludeWindowsSDKRefFrameworkReferences>
    <LakeUIDesignerBackend>DX11</LakeUIDesignerBackend>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
	<UseWPF>True</UseWPF>
	<!--<PublishReadyToRun>True</PublishReadyToRun>
    <PublishReadyToRunEmitSymbols>True</PublishReadyToRunEmitSymbols>-->
	<SelfContained>False</SelfContained>
	<!--<IncludeNativeLibrariesForSelfExtract>True</IncludeNativeLibrariesForSelfExtract>-->
	<!--<EnableCompressionInSingleFile>True</EnableCompressionInSingleFile>-->
	<Authors>1059 Studio</Authors>
	<Company>1059 Studio</Company>
	<Copyright>Copyright (c) 2026 1059 Studio</Copyright>
	<AssemblyVersion>2026.9.14</AssemblyVersion>
	<FileVersion>2026.9.14</FileVersion>
	<Version>2026.9.14</Version>
	<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
	<Title>FFF.Recorder</Title>
	<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
	<ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	<PlatformTarget>x64</PlatformTarget>
	<Prefer32Bit>false</Prefer32Bit>
	<ApplicationIcon>ICO.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\SP_默认背景图.jpg" />
    <EmbeddedResource Include="Assets\Shaders\缩放RGBA.cso" LogicalName="FFF.Recorder.Shaders.ScaleRgba.cso" />
    <EmbeddedResource Include="Assets\Shaders\全屏三角形.cso" LogicalName="FFF.Recorder.Shaders.FullscreenTriangle.cso" />
    <EmbeddedResource Include="Assets\Shaders\复制到BGRA.cso" LogicalName="FFF.Recorder.Shaders.CopyBgra.cso" />
    <EmbeddedResource Include="Assets\Shaders\HDR到PQ.cso" LogicalName="FFF.Recorder.Shaders.HdrToPq.cso" />
    <EmbeddedResource Include="Assets\Shaders\HDR到SDR.cso" LogicalName="FFF.Recorder.Shaders.HdrToSdr.cso" />
    <EmbeddedResource Include="Assets\SP_默认背景图.jpg" LogicalName="FFF.Recorder.Assets.SP_DefaultBackground.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProductNative Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFF.Native\FFF.Native.vcxproj" Condition="'$(MSBuildRuntimeType)' != 'Core'" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true">
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <Content Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" Link="FFF.Native.dll">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="VerifyRecorderFramework" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp' Or '$(TargetFrameworkVersion)' != 'v11.0' Or '$(TargetPlatformIdentifier)' != 'Windows'"
           Text="3FR 需要 .NET 11 Windows 目标框架。当前目标为 $(TargetFramework)。" />
    <Error Condition="'$(IncludeWindowsSDKRefFrameworkReferences)' != 'true'"
           Text="3FR 的屏幕捕获需要 Windows SDK 的 WinRT 投影。" />
  </Target>

  <Target Name="VerifyRecorderBundle" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_RecorderBundlePath Include="@(FilesToBundle->'%(RelativePath)')" />
      <_MissingRecorderProjection Include="Microsoft.Windows.SDK.NET.dll;WinRT.Runtime.dll" Exclude="@(_RecorderBundlePath)" />
    </ItemGroup>
    <Error Condition="'@(_MissingRecorderProjection)' != ''"
           Text="3FR 单文件缺少 WinRT 投影 @(_MissingRecorderProjection)。" />
  </Target>

  <Target Name="CopyNativeRuntime" AfterTargets="Build">
    <Error Condition="!Exists('..\FFF.Native\x64\$(Configuration)\FFF.Native.dll')" Text="请先构建 FFF.Native 的 x64 $(Configuration) 配置。" />
    <Copy SourceFiles="@(ProductNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DevelopmentRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="'$(PublishSingleFile)' != 'true'" />
  </Target>

  <Target Name="CopyProductNativeToPublish" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
    <Copy SourceFiles="@(ProductNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="LakeUI.Notifications" Version="1.0.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LakeUI\LakeUI\LakeUI.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>


  <Import Project="..\..\LakeUI\LakeUI\buildTransitive\LakeUI.targets" />

  <ItemGroup>
    <Compile Update="Form1.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form个性化.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form总控台.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form支持者.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form视频参数.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form设置.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form输出设置.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form音频参数.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Graphics\实时预览控件.vb">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
</Project>
