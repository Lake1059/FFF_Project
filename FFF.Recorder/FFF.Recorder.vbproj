<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TFM 就地定义：默认与上游一致（.NET 10）。切 .NET 11 用 -p:NetTFM=net11.0-windows10.0.26100.0 -->
    <NetTFM Condition="'$(NetTFM)' == ''">net10.0-windows10.0.26100.0</NetTFM>
    <TargetFramework>$(NetTFM)</TargetFramework>
    <!-- LakeUI 是外部商业兄弟仓，构建节奏独立，单独一个 TFM 参数 -->
    <LakeUITfm Condition="'$(LakeUITfm)' == ''">net10.0-windows10.0.17763.0</LakeUITfm>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
	<UseWPF>True</UseWPF>
	<!--<PublishReadyToRun>True</PublishReadyToRun>
    <PublishReadyToRunEmitSymbols>True</PublishReadyToRunEmitSymbols>-->
	<SelfContained>False</SelfContained>
	<!--<IncludeNativeLibrariesForSelfExtract>True</IncludeNativeLibrariesForSelfExtract>-->
	<!--<EnableCompressionInSingleFile>True</EnableCompressionInSingleFile>-->
	<Authors>1059 Studio</Authors>
	<Company>1059 Studio</Company>
	<AssemblyVersion>2026.9.14</AssemblyVersion>
	<FileVersion>2026.9.14</FileVersion>
	<Version>2026.9.14</Version>
	<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
	<Title>FFF.Recorder</Title>
	<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
	<ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	<PlatformTarget>x64</PlatformTarget>
	<Prefer32Bit>false</Prefer32Bit>
	<ApplicationIcon>ICO.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\SP_默认背景图.jpg" />
    <EmbeddedResource Include="Assets\Shaders\缩放RGBA.cso" LogicalName="FFF.Recorder.Shaders.ScaleRgba.cso" />
    <EmbeddedResource Include="Assets\Shaders\全屏三角形.cso" LogicalName="FFF.Recorder.Shaders.FullscreenTriangle.cso" />
    <EmbeddedResource Include="Assets\Shaders\复制到BGRA.cso" LogicalName="FFF.Recorder.Shaders.CopyBgra.cso" />
    <EmbeddedResource Include="Assets\Shaders\HDR到PQ.cso" LogicalName="FFF.Recorder.Shaders.HdrToPq.cso" />
    <EmbeddedResource Include="Assets\Shaders\HDR到SDR.cso" LogicalName="FFF.Recorder.Shaders.HdrToSdr.cso" />
    <EmbeddedResource Include="Assets\SP_默认背景图.jpg" LogicalName="FFF.Recorder.Assets.SP_DefaultBackground.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProductNative Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" />
    <DevelopmentRuntime Include="..\runtime\avcodec*.dll" />
    <DevelopmentRuntime Include="..\runtime\avformat*.dll" />
    <DevelopmentRuntime Include="..\runtime\avutil*.dll" />
    <DevelopmentRuntime Include="..\runtime\swresample*.dll" />
    <DevelopmentRuntime Include="..\runtime\swscale*.dll" />
    <DevelopmentRuntime Include="..\runtime\avfilter*.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFF.Native\FFF.Native.vcxproj" Condition="'$(MSBuildRuntimeType)' != 'Core'" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <Content Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" Link="FFF.Native.dll">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="CopyNativeRuntime" AfterTargets="Build">
    <Error Condition="!Exists('..\FFF.Native\x64\$(Configuration)\FFF.Native.dll')" Text="请先构建 FFF.Native 的 x64 $(Configuration) 配置。" />
    <Copy SourceFiles="@(ProductNative);@(DevelopmentRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyProductNativeToPublish" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
    <Copy SourceFiles="@(ProductNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="LakeUI.Notifications" Version="1.0.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LakeUI">
      <HintPath>..\..\LakeUI\LakeUI\bin\Debug\$(LakeUITfm)\LakeUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>


  <!-- LakeUI 引用护栏：把「LakeUI 找不到」从数百条「未定义类型」错误变成一条明确报错。
       默认（宿主与 LakeUI 同为 .NET 10）不发任何消息，行为与改动前一致。 -->
  <Target Name="VerifyLakeUIReference" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
    <PropertyGroup>
      <_LakeUIRef>$(MSBuildThisFileDirectory)..\..\LakeUI\LakeUI\bin\Debug\$(LakeUITfm)\LakeUI.dll</_LakeUIRef>
      <!-- 大版本号（net10.0-... -> 10.0），仅用于混血检测。先判长度再取子串：
           短串（如 net8.0）会让 Substring 自己抛越界，取代本要给出的明确报错。 -->
      <_NetTfmMajor Condition="$(NetTFM.Length) &gt;= 7">$(NetTFM.Substring(3, 4))</_NetTfmMajor>
      <_LakeUiTfmMajor Condition="$(LakeUITfm.Length) &gt;= 7">$(LakeUITfm.Substring(3, 4))</_LakeUiTfmMajor>
    </PropertyGroup>
    <Error Condition="'$(_NetTfmMajor)' == '' Or '$(_LakeUiTfmMajor)' == ''"
           Text="无法从 TFM 解析大版本号（NetTFM='$(NetTFM)'，LakeUITfm='$(LakeUITfm)'）。期望形如 net10.0-windows10.0.26100.0；混血检测靠它，解析不了就不能放行。" />
    <Error Condition="!Exists('$(_LakeUIRef)')"
           Text="LakeUI 引用缺失，未找到：$(_LakeUIRef)（当前 LakeUITfm=$(LakeUITfm)）。请先在兄弟仓 LakeUI 用该目标框架构建 Debug 配置，或对本工程传入 -p:LakeUITfm=某已有目标框架 指向既有产物。" />
    <Warning Condition="'$(_NetTfmMajor)' != '$(_LakeUiTfmMajor)'"
             Text="宿主 TFM ($(NetTFM)) 与 LakeUI TFM ($(LakeUITfm)) 大版本不一致 —— 当前是「宿主 .NET $(_NetTfmMajor) + UI 库 .NET $(_LakeUiTfmMajor)」的混血状态。运行时可工作（程序集引用向下兼容），但 LakeUI 上游一旦重建别的 TFM，本 HintPath 会静默失效。建议推进 LakeUI 同步升级到与宿主一致的目标框架。" />
  </Target>

</Project>
