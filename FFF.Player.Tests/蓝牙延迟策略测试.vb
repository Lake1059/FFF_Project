Imports FFF.Player

Friend Module 蓝牙延迟策略测试
    ''' <summary>纯算术断言：不碰注册表/COM，保证蓝牙补偿方向与区间中值可回归。</summary>
    Public Function 运行() As Integer
        Dim 失败 As Integer = 0

        断言(蓝牙音频延迟策略.计算补偿100纳秒(False, 蓝牙音频信息.非蓝牙, 60, 0) = 0,
            "关闭时不下发", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 蓝牙音频信息.非蓝牙, 60, 0) = 0,
            "非蓝牙不下发", 失败)

        Dim 未连接 As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = False,
            .协议 = 蓝牙音频协议.A2DP,
            .延迟下界毫秒 = 150,
            .延迟上界毫秒 = 300
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 未连接, 60, 0) = 0,
            "蓝牙未连接不下发", 失败)

        Dim A2DP As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = True,
            .协议 = 蓝牙音频协议.A2DP,
            .延迟下界毫秒 = 150,
            .延迟上界毫秒 = 300
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0) = -1_866_667L,
            "A2DP/60Hz = -186.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 144, 0) = -2_061_111L,
            "A2DP/144Hz = -206.1ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 20) = -2_066_667L,
            "额外提前量 20ms 叠加", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 200) = -2_866_667L,
            "额外提前量上限钳到 100ms", 失败)

        ' A2DP codec 手动覆盖：表值中值 = 200/150/120/130/40/130/120/90ms。
        断言(蓝牙音频延迟策略.编码区间(蓝牙音频编码.SBC).下界 = 190 AndAlso
            蓝牙音频延迟策略.编码区间(蓝牙音频编码.SBC).上界 = 210,
            "SBC 区间 190–210ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0, 蓝牙音频编码.SBC) = -1_616_667L,
            "A2DP SBC/60Hz = -161.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0, 蓝牙音频编码.AAC) = -1_116_667L,
            "A2DP AAC/60Hz = -111.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0, 蓝牙音频编码.AptX) = -816_667L,
            "A2DP aptX/60Hz = -81.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0, 蓝牙音频编码.AptXHD) = -916_667L,
            "A2DP aptX HD/60Hz = -91.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0, 蓝牙音频编码.AptXLL) = -16_667L,
            "A2DP aptX LL/60Hz = -1.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0, 蓝牙音频编码.LDAC) = -916_667L,
            "A2DP LDAC/60Hz = -91.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0, 蓝牙音频编码.LHDC) = -816_667L,
            "A2DP LHDC/60Hz = -81.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0, 蓝牙音频编码.L2HC) = -516_667L,
            "A2DP L2HC/60Hz = -51.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0, 蓝牙音频编码.LC3) = -1_866_667L,
            "A2DP 不接受 LE 的 LC3 手动项", 失败)
        断言(蓝牙音频延迟策略.有效延迟区间(A2DP, 蓝牙音频编码.AAC).下界 = 140 AndAlso
            蓝牙音频延迟策略.有效延迟区间(A2DP, 蓝牙音频编码.AAC).上界 = 160,
            "AAC 有效区间覆盖协议区间", 失败)
        断言(蓝牙音频延迟策略.编码名称(蓝牙音频编码.AptXLL) = "aptX LL",
            "aptX LL 显示名", 失败)

        Dim HFP As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = True,
            .协议 = 蓝牙音频协议.HFP,
            .延迟下界毫秒 = 100,
            .延迟上界毫秒 = 250
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, HFP, 60, 0) = -1_366_667L,
            "HFP/60Hz = -136.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, HFP, 60, 0, 蓝牙音频编码.AAC) = -1_366_667L,
            "HFP 忽略 A2DP codec 选择", 失败)
        断言(蓝牙音频延迟策略.有效延迟区间(HFP, 蓝牙音频编码.AAC).下界 = 100,
            "HFP 保留协议下界", 失败)

        Dim LE As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = True,
            .协议 = 蓝牙音频协议.LEAudio,
            .延迟下界毫秒 = 30,
            .延迟上界毫秒 = 100
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, LE, 60, 0) = -266_667L,
            "LE Audio/60Hz = -26.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, LE, 60, 0, 蓝牙音频编码.AAC) = -266_667L,
            "LE Audio 忽略非 LC3 codec", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, LE, 60, 0, 蓝牙音频编码.LC3) = -266_667L,
            "LE Audio LC3/60Hz = -26.7ms", 失败)

        Dim 未知 As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = True,
            .协议 = 蓝牙音频协议.未知
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 未知, 60, 0) = -1_866_667L,
            "未知协议按 A2DP 区间兜底", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 未知, 60, 0, 蓝牙音频编码.AAC) = -1_116_667L,
            "未知协议可用手动 codec 覆盖", 失败)

        ' 端点 PCM 格式：多声道 +8ms、96k+ +6ms、24bit+ +3ms；格式未知仍退回协议中值。
        Dim 多声道 As New 蓝牙音频信息 With {
            .是蓝牙 = True, .已连接 = True, .协议 = 蓝牙音频协议.A2DP,
            .延迟下界毫秒 = 150, .延迟上界毫秒 = 300,
            .输出格式 = 格式(48000, 6, 16)
        }
        断言(蓝牙音频延迟策略.格式开销毫秒(多声道.输出格式) = 8.0,
            "5.1 格式开销 8ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 多声道, 60, 0) = -1_946_667L,
            "A2DP 5.1/60Hz = -194.7ms", 失败)

        Dim 高清 As New 蓝牙音频信息 With {
            .是蓝牙 = True, .已连接 = True, .协议 = 蓝牙音频协议.A2DP,
            .延迟下界毫秒 = 150, .延迟上界毫秒 = 300,
            .输出格式 = 格式(96000, 2, 24)
        }
        断言(蓝牙音频延迟策略.格式开销毫秒(高清.输出格式) = 9.0,
            "96k/24bit 格式开销 9ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 高清, 60, 0) = -1_956_667L,
            "A2DP 96k/24bit/60Hz = -195.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 高清, 144, 0) = -2_151_111L,
            "A2DP 96k/24bit/144Hz = -215.1ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 高清, 60, 0, 蓝牙音频编码.AAC) = -1_206_667L,
            "AAC + 96k/24bit 格式开销/60Hz = -120.7ms", 失败)

        Dim 普通24 As New 蓝牙音频信息 With {
            .是蓝牙 = True, .已连接 = True, .协议 = 蓝牙音频协议.A2DP,
            .延迟下界毫秒 = 150, .延迟上界毫秒 = 300,
            .输出格式 = 格式(48000, 2, 24)
        }
        断言(蓝牙音频延迟策略.格式开销毫秒(普通24.输出格式) = 3.0,
            "48k/24bit 格式开销 3ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 普通24, 60, 0) = -1_896_667L,
            "A2DP 48k/24bit/60Hz = -189.7ms", 失败)

        Dim LE高清 As New 蓝牙音频信息 With {
            .是蓝牙 = True, .已连接 = True, .协议 = 蓝牙音频协议.LEAudio,
            .延迟下界毫秒 = 30, .延迟上界毫秒 = 100,
            .输出格式 = 格式(48000, 2, 24)
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, LE高清, 60, 0) = -296_667L,
            "LE Audio 48k/24bit/60Hz = -29.7ms", 失败)

        ' 刷新率组合：24/30Hz 必须保留两帧，不能被旧的 60ms 上限截断。
        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(24) - 88.33333333333333) < 0.0001,
            "24Hz 屏幕延迟 88.33ms", 失败)
        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(30) - 71.66666666666667) < 0.0001,
            "30Hz 屏幕延迟 71.67ms", 失败)
        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(240) - 13.333333333333334) < 0.0001,
            "240Hz 屏幕延迟 13.33ms", 失败)
        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(360) - 10.555555555555555) < 0.0001,
            "360Hz 屏幕延迟 10.56ms", 失败)
        断言(蓝牙音频延迟策略.估计屏幕延迟毫秒(500) = 10.0,
            "500Hz 下限钳到 10ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 24, 0) = -1_366_667L,
            "A2DP/24Hz = -136.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 30, 0) = -1_533_333L,
            "A2DP/30Hz = -153.3ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 240, 0) = -2_116_667L,
            "A2DP/240Hz = -211.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 360, 0) = -2_144_444L,
            "A2DP/360Hz = -214.4ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 500, 0) = -2_150_000L,
            "A2DP/500Hz = -215.0ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 1000, 0) = -1_866_667L,
            "非法刷新率回退 60Hz", 失败)
        断言(蓝牙音频延迟策略.格式开销毫秒(Nothing) = 0.0,
            "格式缺失不增加开销", 失败)

        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(60) - 38.333333333333336) < 0.0001,
            "60Hz 屏幕延迟 38.33ms", 失败)
        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(144) - 18.88888888888889) < 0.0001,
            "144Hz 屏幕延迟 18.89ms", 失败)
        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(0) - 38.333333333333336) < 0.0001,
            "非法刷新率回落 60Hz（0）", 失败)

        If 失败 = 0 Then
            Console.WriteLine("蓝牙延迟策略测试：全部通过。")
        Else
            Console.WriteLine($"蓝牙延迟策略测试：{失败} 项失败。")
        End If
        Return 失败
    End Function

    Private Function 格式(采样率 As Integer, 声道数 As Integer, 位深 As Integer) As 音频输出格式
        Return New 音频输出格式 With {
            .已获取 = True,
            .采样率 = 采样率,
            .声道数 = 声道数,
            .位深 = 位深,
            .有效位深 = 位深,
            .格式标签 = 1,
            .格式名称 = "PCM"
        }
    End Function

    ''' <summary>打印当前默认端点的探测事实，便于现场核对格式/协议，不参与断言。
    ''' 可选传入端点 ID（非 -- 开头的参数），用于检查未连接/非默认的蓝牙端点。</summary>
    Public Function 探测(参数 As String()) As Integer
        Dim 指定端点 As String = ""
        For Each 项 In 参数
            If Not 项.StartsWith("--", StringComparison.Ordinal) Then 指定端点 = 项
        Next
        Dim 信息 = If(指定端点.Length = 0, 蓝牙音频检测器.检测默认输出(),
            蓝牙音频检测器.检测指定端点(指定端点))
        Dim 格式文本 = If(信息.输出格式 IsNot Nothing AndAlso 信息.输出格式.已获取,
            信息.输出格式.描述 & "（" & 信息.输出格式.格式名称 & "）", "格式未知")
        Console.WriteLine($"蓝牙={信息.是蓝牙} 已连接={信息.已连接} 协议={信息.协议名称} " &
            $"区间={信息.延迟下界毫秒}-{信息.延迟上界毫秒}ms 格式={格式文本} " &
            $"设备={信息.设备名称} 端点={信息.端点名称} 状态={信息.端点状态} 说明={信息.说明}")
        Return 0
    End Function

    Private Sub 断言(条件 As Boolean, 名称 As String, ByRef 失败 As Integer)
        If 条件 Then Return
        Console.WriteLine("FAIL " & 名称)
        失败 += 1
    End Sub
End Module
