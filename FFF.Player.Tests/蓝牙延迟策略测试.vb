Imports FFF.Player

Friend Module 蓝牙延迟策略测试
    ''' <summary>纯算术断言：不碰注册表/COM，保证蓝牙补偿方向与区间中值可回归。</summary>
    Public Function 运行() As Integer
        Dim 失败 As Integer = 0

        断言(蓝牙音频延迟策略.计算补偿100纳秒(False, 蓝牙音频信息.非蓝牙, 60, 0) = 0,
            "关闭时不下发", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 蓝牙音频信息.非蓝牙, 60, 0) = 0,
            "非蓝牙不下发", 失败)

        Dim 未连接 As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = False,
            .协议 = 蓝牙音频协议.A2DP,
            .延迟下界毫秒 = 150,
            .延迟上界毫秒 = 300
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 未连接, 60, 0) = 0,
            "蓝牙未连接不下发", 失败)

        Dim A2DP As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = True,
            .协议 = 蓝牙音频协议.A2DP,
            .延迟下界毫秒 = 150,
            .延迟上界毫秒 = 300
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 0) = -1_866_667L,
            "A2DP/60Hz = -186.7ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 144, 0) = -2_061_111L,
            "A2DP/144Hz = -206.1ms", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 20) = -2_066_667L,
            "额外提前量 20ms 叠加", 失败)
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, A2DP, 60, 200) = -2_866_667L,
            "额外提前量上限钳到 100ms", 失败)

        Dim HFP As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = True,
            .协议 = 蓝牙音频协议.HFP,
            .延迟下界毫秒 = 100,
            .延迟上界毫秒 = 250
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, HFP, 60, 0) = -1_366_667L,
            "HFP/60Hz = -136.7ms", 失败)

        Dim LE As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = True,
            .协议 = 蓝牙音频协议.LEAudio,
            .延迟下界毫秒 = 30,
            .延迟上界毫秒 = 100
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, LE, 60, 0) = -266_667L,
            "LE Audio/60Hz = -26.7ms", 失败)

        Dim 未知 As New 蓝牙音频信息 With {
            .是蓝牙 = True,
            .已连接 = True,
            .协议 = 蓝牙音频协议.未知
        }
        断言(蓝牙音频延迟策略.计算补偿100纳秒(True, 未知, 60, 0) = -1_866_667L,
            "未知协议按 A2DP 区间兜底", 失败)

        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(60) - 38.333333333333336) < 0.0001,
            "60Hz 屏幕延迟 38.33ms", 失败)
        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(144) - 18.88888888888889) < 0.0001,
            "144Hz 屏幕延迟 18.89ms", 失败)
        断言(Math.Abs(蓝牙音频延迟策略.估计屏幕延迟毫秒(0) - 38.333333333333336) < 0.0001,
            "非法刷新率回落 60Hz", 失败)

        If 失败 = 0 Then
            Console.WriteLine("蓝牙延迟策略测试：全部通过（13 项）。")
        Else
            Console.WriteLine($"蓝牙延迟策略测试：{失败} 项失败。")
        End If
        Return 失败
    End Function

    Private Sub 断言(条件 As Boolean, 名称 As String, ByRef 失败 As Integer)
        If 条件 Then Return
        Console.WriteLine("FAIL " & 名称)
        失败 += 1
    End Sub
End Module
