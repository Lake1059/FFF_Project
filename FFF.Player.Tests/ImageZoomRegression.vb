' 图片模式缩放律 —— 同进程回归
'
' 测的是 FFF.Player.UI 里那份真正跑的 图片缩放几何，不是这里的复述：钳位、换算、
' 弹簧步进全部直接调产品代码。GUI 接线（计时器启停、双击、滚轮事件）在本机没有
' 可判的读档，按 docs/79 §4 明记"未测"，不在这一档里冒充覆盖。
'
' 期望值一律手算并把算式写在注释里（改前有两处拿 图片缩放几何 自己的常数当期望值，
' 那是同义反复，永远红不了）。内核的两条钳位 [0.05, 64] 是**被测模块之外**的权威数
' （钳位在 VideoRenderer.cpp:2327-2328 与 :2377，两个入口两套界；旧注释引用的 2120/2153 实为 DirectWrite 与构造函数，已订正），所以这里写成字面量并注明出处，不引用模块常数。
'
' 小图档（源边长 < 视口边长）是本轮加的牙：内核把适配盒恒封顶在源原生尺寸
' （PlayerSession.cpp:3708/1642 → VideoRenderer.cpp:967-970 ⇒ f = Min(1, 适应比)），
' 旧几何层按"不封顶"建模，于是 1:1 档、上界、平移判据整体偏 f 倍 —— 而大图档
' f<1，封顶恰好不咬，所以只测大图会一路绿灯地把这个错带着走。
'
' 用法：FFF.Player.Tests --image-zoom-regression
' 退出码：0 全绿 / 1 有失败条 / 2 用法

Imports System
Imports FFF.Player

Friend Module ImageZoomRegression
    Private 通过 As Integer
    Private 失败 As Integer

    Private Sub 检查(条件 As Boolean, 名称 As String, 实测 As String)
        If 条件 Then
            通过 += 1
            Console.WriteLine($"  ok   {名称}  {实测}")
        Else
            失败 += 1
            Console.WriteLine($"  FAIL {名称}  {实测}")
        End If
    End Sub

    Private Function 相近(值 As Single, 期望 As Single, 容差 As Double) As Boolean
        Return Math.Abs(CDbl(值) - CDbl(期望)) <= 容差
    End Function

    Friend Function 运行(参数 As String()) As Integer
        Console.WriteLine("图片缩放几何回归")

        ' ── 1. 往返律：×1.25^n 后 ×0.8^n 必须回到原值，且全程不触界 ──────────
        ' 手算：1.25 × 0.8 = 1 ⇒ 1.25^8 × 0.8^8 = (1.25×0.8)^8 = 1 ⇒ 终点 == 起点 1.0。
        Dim 起点 = 1.0F
        Dim 值 = 起点
        For i = 1 To 8
            值 *= 图片缩放几何.缩放步进
        Next
        Dim 峰值 = 值
        For i = 1 To 8
            值 *= 图片缩放几何.反向步进
        Next
        检查(相近(值, 起点, 0.00001), "往返 8+8 步回到原值", $"{值:F8}")
        检查(峰值 > 起点, "往返确实经过放大", $"峰值={峰值:F4}")

        ' ── 2. 适应比与 f（=1:1 所在档）──────────────────────────────────────
        ' 大图 12000×9000 进 1264×681：限制轴是高 ⇒ 适应比 = min(1264/12000, 681/9000)
        ' = min(0.105333, 0.0756667) = 0.0756667，小于 1 ⇒ 封顶 Min(1,·) 不咬，f 就是它。
        Dim 大图f = 图片缩放几何.单位屏幕比(1264, 681, 12000UI, 9000UI)
        检查(相近(大图f, 681.0F / 9000.0F, 0.0001), "大图 f=视口高/源高", $"{大图f:F6}")
        ' 手算 1/f = 9000/681 = 13.2158，且 13.2158 < 内核 64 ⇒ 不被上钳。
        检查(相近(图片缩放几何.一比一缩放(大图f), 9000.0F / 681.0F, 0.01),
             "大图 1:1 = 1/f ≈ 13.22", $"{图片缩放几何.一比一缩放(大图f):F4}")

        Dim 小图f = 图片缩放几何.单位屏幕比(1264, 681, 200UI, 200UI)
        检查(相近(小图f, 1.0F, 0.0001), "小图封顶后 f=1（不被强制放大铺窗）", $"{小图f:F6}")
        ' 手算：f=1 ⇒ 1/f = 1 ⇒ clamp(1, 0.05, 64) = 1.0。
        检查(相近(图片缩放几何.一比一缩放(小图f), 1.0F, 0.0001), "小图 1:1 就是 z=1",
             $"{图片缩放几何.一比一缩放(小图f):F4}")

        ' 封顶位（旧 API 的 原生尺寸封顶开启 参数）在产品里恒为真 —— 内核就是这么摆的，
        ' 新 API 于是把它删了。未封顶的那一面现在只能由 适应比 读到，而它正是旧几何拿去做
        ' f 用的那个数：min(1264/200, 681/200) = min(6.32, 3.405) = 3.405。
        Dim 小图适应比 = 图片缩放几何.适应比(1264, 681, 200UI, 200UI)
        检查(相近(小图适应比, 681.0F / 200.0F, 0.001), "小图 适应比=3.405（旧几何把它当 f 用）",
             $"{小图适应比:F4}")

        ' ── 2b. 小图档整族：源 200×200 < 视口 1264×681（D1 的新牙）─────────────
        ' 这一对（封顶 f=1.0 / 未封顶 适应比=3.405）就是"大图看不出、小图全错"的分水岭，
        ' 所以两条都要判，只判一条等于没判。
        Dim 小图视口宽 = 1264, 小图视口高 = 681
        Dim 小图源 = 200UI
        检查(相近(小图f, 1.0F, 0.0001), "小图 单位屏幕比=1.0（Min(1,3.405) 恒封顶）",
             $"f={小图f:F4} vs 适应比={小图适应比:F4}")
        检查(小图f < 小图适应比, "小图 f 严格低于 适应比（两档成对才分得开 regime）",
             $"1.0 < 3.405 ⇒ 实测 f={小图f:F4} 适应比={小图适应比:F4}")
        ' 适配盒 = 源边长 × f = 200 × 1.0 = 200。旧几何算成 200×3.405 = 681（铺满窗口），
        ' 那既是"小图发虚"的来源，也是下面拖动灵敏度差 3.4 倍的来源。
        检查(相近(图片缩放几何.适配盒宽(小图视口宽, 小图视口高, 小图源, 小图源), 200.0F, 0.01),
             "小图 适配盒宽=原生 200（不是 681 铺窗）",
             $"{图片缩放几何.适配盒宽(小图视口宽, 小图视口高, 小图源, 小图源):F1} vs 控件宽 1264/旧算 681")
        检查(相近(图片缩放几何.适配盒高(小图视口宽, 小图视口高, 小图源, 小图源), 200.0F, 0.01),
             "小图 适配盒高=原生 200（不是控件高 681）",
             $"{图片缩放几何.适配盒高(小图视口宽, 小图视口高, 小图源, 小图源):F1} vs 控件高 681")
        ' 上界：64 / f = 64/1.0 = 64 ⇒ clamp(64, 0.05, 64) = 64。
        ' 旧几何用未封顶的 3.405 去除：64/3.405 = 18.796 ⇒ 小了 3.405 倍，滚到 18.79 就"没反应"。
        检查(相近(图片缩放几何.最大缩放(小图f), 64.0F, 0.0001),
             "小图上界=64（修前 64/3.405=18.79）",
             $"{图片缩放几何.最大缩放(小图f):F2} vs 修前 18.79（差 3.4×）")
        ' 1:1 档与可达性：f=1 ⇒ 1/f = 1 ≤ 64 ⇒ 可达；两条边都小于视口 ⇒ 适应就是 1:1。
        检查(相近(图片缩放几何.一比一缩放(小图f), 1.0F, 0.0001), "小图 一比一缩放=1.0（1/1）",
             $"{图片缩放几何.一比一缩放(小图f):F4}")
        检查(图片缩放几何.一比一可达(小图视口宽, 小图视口高, 小图源, 小图源),
             "小图 1:1 可达", "1/f=1<=64")
        检查(图片缩放几何.适应即一比一(小图视口宽, 小图视口高, 小图源, 小图源),
             "小图 适应即一比一（双击该说清楚，D4）", "200<1264 且 200<681")
        ' 反向对照，免得 适应即一比一 做成恒真：两轴都超出 ⇒ False。
        检查(Not 图片缩放几何.适应即一比一(1264, 681, 12000UI, 9000UI),
             "大图 适应即一比一=False（两轴都超）", "12000>1264 且 9000>681")
        ' 只超一轴同样不算"整图入窗"：源 1000×800，宽 1000<1264 但高 800>681 ⇒ False；
        ' 该例 f = min(1264/1000, 681/800) = min(1.264, 0.85125) = 0.85125（未触封顶）。
        检查(Not 图片缩放几何.适应即一比一(1264, 681, 1000UI, 800UI),
             "半入窗 适应即一比一=False（判据不是 f<1）", "1000×800 只超一轴")
        检查(相近(图片缩放几何.单位屏幕比(1264, 681, 1000UI, 800UI), 681.0F / 800.0F, 0.0001),
             "半入窗 f=681/800=0.85125", $"{图片缩放几何.单位屏幕比(1264, 681, 1000UI, 800UI):F6}")
        ' 平移判据：显示边长 = 源边长 × f × z = 200 × 1 × z。z=1.86 ⇒ 372×372，两轴都在
        ' 视口里（372 < 1264、372 < 681）⇒ 无余量。旧几何按未封顶 f=3.405 算成
        ' 681×1.86 = 1266.66 > 1264 ⇒ 误报"有余量"，于是允许拖一段根本动不了的画。
        检查(Not 图片缩放几何.有平移余量(1.86F, 小图f, 小图源, 小图源, 小图视口宽, 小图视口高),
             "小图 z=1.86 显示 372×372 无余量（修前误判 True）", "372<1264 且 372<681")
        检查(图片缩放几何.有平移余量(10.0F, 小图f, 小图源, 小图源, 小图视口宽, 小图视口高),
             "小图 z=10 显示 2000×2000 有余量", "2000>1264")

        ' ── 3. 上界：每像素 64 屏幕像素 与内核 64 取更紧者 ───────────────────
        ' 手算：64/0.0756667 = 845.8 ⇒ 被内核上钳 64 夹住 ⇒ 64.0（这个 64 出自
        ' VideoRenderer.cpp:2377，不是引用被测模块的常数；图片模式绝对路径 :2327-2328 是 [1.0,32]）。
        检查(相近(图片缩放几何.最大缩放(大图f), 64.0F, 0.0001),
             "大图上界被内核 64 夹住（够不到 64px/px）",
             $"{图片缩放几何.最大缩放(大图f):F2}（64/f=845.8 被夹）")
        ' 手算：64/1.0 = 64 ⇒ 不被夹，就是 64px/px。
        检查(相近(图片缩放几何.最大缩放(1.0F), 64.0F, 0.0001), "1:1 基准时上界=64px/px", "64.00")
        ' ⚠ 这不是判据，是契约记录，别把它读成"下界被测过"：最小缩放() 的实现是
        ' 一句 Return 1.0F（图片缩放几何.vb:72-74），而全仓只有两个测试引用它
        ' （本行与 ImageZoomLiveRegression.vb:296），**出货路径的钳位不经过这个函数**。
        ' 所以这条断言除了改常量永远不会红，也不能证明真机上画面不会缩到 1.0 以下。
        ' 真正管住下界的是 钳制缩放/内核 0.05 下钳那条线，它不在本档覆盖内——已入账。
        检查(相近(图片缩放几何.最小缩放(), 1.0F, 0.0001),
             "下界契约值 = 1.0（记录，非判据：该函数无出货调用点）", "1.00")

        ' ── 4. 1:1 够不够得着：源边长 > 64×视口边长 就够不着 ─────────────────
        ' 手算：256/16384 = 0.015625 = 1/64 ⇒ 1/f = 64 ⇒ 刚好够（边界含等号）。
        检查(图片缩放几何.一比一可达(256, 256, 16384UI, 64UI), "边界 64× 判可达", "256↔16384")
        ' 手算：200/16384 = 0.0122070 ⇒ 1/f = 81.92 > 64 ⇒ 够不着。
        检查(Not 图片缩放几何.一比一可达(200, 200, 16384UI, 64UI), "65× 判不可达（须显式告知）", "200↔16384")

        ' ── 4b. 适配盒：内核摆放与平移的基准，非限制轴上它 **不等于** 控件尺寸
        ' 手算：f = 681/9000 = 0.0756667 ⇒ 高 = 9000f = 681（限制轴）、宽 = 12000f = 908。
        Dim 盒宽 = 图片缩放几何.适配盒宽(1264, 681, 12000UI, 9000UI)
        Dim 盒高 = 图片缩放几何.适配盒高(1264, 681, 12000UI, 9000UI)
        检查(相近(盒高, 681.0F, 0.5F), "适配盒高=限制轴=控件高", $"{盒高:F1}")
        检查(相近(盒宽, 681.0F * 12000.0F / 9000.0F, 1.0F), "适配盒宽≠控件宽（非限制轴）", $"{盒宽:F1} vs 控件 1264")
        ' 手算：200 × min(1, 3.405) = 200 × 1 = 200（不是 681）。
        检查(相近(图片缩放几何.适配盒宽(1264, 681, 200UI, 200UI), 200.0F, 0.01F),
             "封顶后小图适配盒=原生 200（不放大铺窗）", $"{图片缩放几何.适配盒宽(1264, 681, 200UI, 200UI):F1}")

        ' ── 5. 平移余量：换成真实几何判据，不再用 z<=1 那条启发式 ────────────
        检查(Not 图片缩放几何.有平移余量(1.0F, 小图f, 200UI, 200UI, 1264, 681),
             "小图 z=1 无平移余量", "显示 200×200")
        检查(图片缩放几何.有平移余量(10.0F, 小图f, 200UI, 200UI, 1264, 681),
             "小图 z=10 有余量", "显示 2000×2000")
        ' 手算：12000×0.0756667×1 = 908×681 ⇒ 高恰好等于控件高（681），未超 ⇒ 无余量。
        检查(Not 图片缩放几何.有平移余量(1.0F, 大图f, 12000UI, 9000UI, 1264, 681),
             "大图 z=1 恰好入窗，无余量", "显示 908×681")
        ' 手算：908×1.25 = 1135、681×1.25 = 851 > 681 ⇒ 有余量。
        检查(图片缩放几何.有平移余量(1.25F, 大图f, 12000UI, 9000UI, 1264, 681),
             "大图 z=1.25 有余量", "显示 1135×851")

        ' ── 6. 钳位一致性：宿主界不得越过内核界 ─────────────────────────────
        ' 手算：低 = max(1.0, 0.05) = 1.0；高 = min(1e6, 64) = 64 ⇒ clamp(9999, 1, 64) = 64。
        检查(相近(图片缩放几何.钳制缩放(9999.0F, 1.0F, 1e6F), 64.0F, 0.0001),
             "上界大于内核时以内核为准", "64.00")
        ' 手算：NaN 走"返回下界"那条路 ⇒ 1.0，绝不把 NaN 传下去（传下去内核会再夹一次，两边不一致）。
        检查(相近(图片缩放几何.钳制缩放(Single.NaN, 1.0F, 64.0F), 1.0F, 0.0001),
             "NaN 夹到下界而不是传下去", "1.00")
        ' 手算：低 = max(60, 0.05) = 60、高 = min(10, 64) = 10 < 低 ⇒ 退化取低 ⇒ clamp(50, 60, 60) = 60。
        检查(相近(图片缩放几何.钳制缩放(50.0F, 60.0F, 10.0F), 60.0F, 0.0001),
             "上界<下界的退化情形返回下界", "60.00")

        ' ── 6b. 坏回读：内核 disc 分支返回 Success 却不写 out-param（D3）───────
        ' 宿主把内核回读当"当前值/上界"接着用（控制器 :303），回读是 0/-1/NaN 时以前没人管，
        ' 于是能在 UI 线程上抛 ArgumentOutOfRangeException。这一档只钉 钳制缩放 的底线：
        ' 输出恒落在内核那两条界内 —— 界取字面量 0.05 / 64.0（VideoRenderer.cpp:2377，ZoomViewAt；绝对路径另有一套 :2327-2328）。
        Dim 坏值() As Single = {0.0F, -1.0F, Single.NaN, Single.PositiveInfinity, Single.MaxValue, 0.5F}
        Dim 坏名() As String = {"0（disc 分支没写出参）", "-1", "NaN", "+Inf",
                                "Single.MaxValue", "0.5（低于宿主下界）"}
        ' ⚠ 出处订正（2026-10-14 实测）：原先注的 VideoRenderer.cpp:2120/:2153 是
        ' DirectWrite 的 SetMaxWidth 与构造函数初始化，**与本钳位无关**。
        ' 内核真实的两条线互不相同：
        '   SetViewTransform  :2327-2328 → 图片模式下 clamp 到 [1.0, 32.0]
        '   ZoomViewAt        :2377      → clamp 到 [0.05, 64.0]
        ' 本档沿用 0.05/64 是 ZoomViewAt 那一支；图片模式最终走哪条**尚未判定**
        ' （取决于宿主实际调哪个入口），已入账待裁。
        Const 内核下钳 As Single = 0.05F   ' 出处：VideoRenderer.cpp:2377（ZoomViewAt）
        Const 内核上钳 As Single = 64.0F   ' 出处：VideoRenderer.cpp:2377；图片模式入口 :2328 为 32.0
        For i = 0 To 坏值.Length - 1
            ' 正常界 [1.0, 64.0]：任何输入出来都必须在 [0.05, 64] 内、有限、且严格大于 0。
            Dim r = 图片缩放几何.钳制缩放(坏值(i), 1.0F, 64.0F)
            检查(r >= 内核下钳 AndAlso r <= 内核上钳 AndAlso Single.IsFinite(r) AndAlso r > 0.0F,
                 $"坏回读 {坏名(i)} 钳位后仍是内核合法值", $"{r:F4} ∈[0.05,64]")
        Next
        For i = 0 To 坏值.Length - 1
            ' 更狠的一层：界本身被回读污染成 0（宿主把 结果缩放=0 同时当上下界）。
            ' 契约"恒落在 [内核最小, 内核最大]"就是为这一种情形写的：NaN/±Inf 走
            ' "返回下界"那条路时也得夹过再返回，不能把脏下界原样吐出去。
            Dim r = 图片缩放几何.钳制缩放(坏值(i), 0.0F, 0.0F)
            检查(r >= 内核下钳 AndAlso Single.IsFinite(r) AndAlso r > 0.0F,
                 $"界被污染成 0 时 {坏名(i)} 依旧落到内核下钳", $"{r:F4} 应>=0.05")
        Next
        Dim 零回读 = 图片缩放几何.钳制缩放(0.0F, 1.0F, 0.0F)
        检查(零回读 > 0.0F, "0 回读钳位后绝不 <=0（UI 线程越界异常的种子）", $"{零回读:F4}")
        Dim NaN脏界 = 图片缩放几何.钳制缩放(Single.NaN, 0.0F, 64.0F)
        检查(NaN脏界 > 0.0F AndAlso NaN脏界 >= 内核下钳,
             "NaN + 脏下界时「返回下界」那条路仍须夹进内核界", $"{NaN脏界:F4} 应>=0.05")

        ' ── 7. 弹簧：不过冲、会停、且**停得够快**（体感预算，不是形容词）──────
        ' 一格滚轮的位移是 1.0→1.25；一次跨档的位移取 1.0→2.0。两个幅度都要在预算内停表，
        ' 否则就是"糊"。上一版用 阻尼0.18s + 绝对阈值，实测停表 0.93s —— 那种手感不能签。
        For Each 幅度 In New Single() {1.25F, 2.0F}
            For Each 步长 In New Single() {1.0F / 60.0F, 1.0F / 125.0F, 0.030F}
                Dim 当前 = 1.0F, 速度 = 0.0F, 最高 = 1.0F, 步数 = 0
                While 步数 < 4000 AndAlso Not 图片缩放几何.已静止(当前, 幅度, 速度)
                    当前 = 图片缩放几何.阻尼步进(当前, 幅度, 速度, 步长, 图片缩放几何.缩放阻尼时间秒)
                    If 当前 > 最高 Then 最高 = 当前
                    步数 += 1
                End While
                Dim 停表秒 = CSng(步数) * 步长
                检查(步数 < 4000, $"弹簧静止(目标{幅度},dt={步长:F4})", $"{步数} 步")
                检查(最高 <= 幅度 + 0.0001F, $"临界阻尼不过冲(目标{幅度},dt={步长:F4})",
                     $"峰值={最高:F6}")
                检查(相近(当前, 幅度, 0.006), $"终点贴住目标(目标{幅度},dt={步长:F4})", $"{当前:F6}")
                检查(停表秒 >= 0.06F AndAlso 停表秒 <= 0.35F,
                     $"停表预算 60~350ms(目标{幅度},dt={步长:F4})", $"{停表秒 * 1000.0F:F0} ms")
            Next
        Next
        ' 粗步长（UI 线程被拖慢到 30ms）也必须不发散 —— 这是"稳定"与"已更新"之外的第三种坏法。
        ' 手算：间隔秒<=0 这条短路直接返回当前值 3.0，不许一步跳到目标 1.0。
        Dim 守速度 = 0.5F
        检查(相近(图片缩放几何.阻尼步进(3.0F, 1.0F, 守速度, 0.0F, 图片缩放几何.缩放阻尼时间秒), 3.0F, 0.0001),
             "间隔秒<=0 时不动而不是一步跳到目标", "3.00")

        Console.WriteLine($"通过 {通过} 条，失败 {失败} 条")
        If 失败 > 0 Then Return 1
        Return 0
    End Function
End Module
