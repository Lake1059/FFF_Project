<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\third_party\FFmpegRuntime.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NetTFM Condition="'$(NetTFM)' == ''">net11.0-windows10.0.19041.0</NetTFM>
    <TargetFramework>$(NetTFM)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace></RootNamespace>
    <StartupObject>Program</StartupObject>
    <AssRuntimeDir>..\third_party\vcpkg_installed\x64-windows\bin</AssRuntimeDir>
    <AssRuntimeDir Condition="'$(Configuration)' == 'Debug'">..\third_party\vcpkg_installed\x64-windows\debug\bin</AssRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standalone tests link the same AI state machine and can run without the player. -->
    <Compile Remove="AI字幕\state-machine-test\**\*.vb" />
    <ProjectReference Include="..\FFF.Player\FFF.Player.vbproj" />
    <!-- ASS 字体回退回归加载与播放器同一套 libass。 -->
    <None Include="$(AssRuntimeDir)\ass-*.dll;$(AssRuntimeDir)\brotli*.dll;$(AssRuntimeDir)\fribidi-*.dll;$(AssRuntimeDir)\harfbuzz.dll;$(AssRuntimeDir)\bz2*.dll;$(AssRuntimeDir)\freetype*.dll;$(AssRuntimeDir)\libpng*.dll;$(AssRuntimeDir)\z*.dll"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FFF.Native\x64\$(Configuration)\FFF.Native.dll" Link="FFF.Native.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- 关联回归用 Raw格式.X3F可用 判断随包 LibRaw 的能力位；测试进程必须能加载同一份 DLL。 -->
    <None Include="..\third_party\libraw\bin\x64\libraw.dll" Link="libraw.dll"
          Condition="Exists('..\third_party\libraw\bin\x64\libraw.dll')"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- 真实解码回归要打开样片。内核按 DELAYLOAD 约定**只**从 FFF.Native.dll 所在目录
         与 exe 目录找 avcodec/avformat 等运行库，不走 PATH，所以测试输出必须带上同一套 dll。 -->
    <None Include="@(DevelopmentRuntime)" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
